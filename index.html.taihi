<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="theme-color" content="#0B0D13">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>PitchWatch — 本番進行支援</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ============ Design tokens ============ */
:root{
  --bg:#0B0D13; --bg2:#10131C; --surface:#151926; --surface2:#1C2132;
  --line:rgba(160,178,222,.13); --line2:rgba(160,178,222,.24);
  --text:#EDF1FA; --text2:#9AA6C2; --text3:#5E6A87;
  --accent:#FFB02E; --accent-ink:#1A1000; --accent-soft:rgba(255,176,46,.14);
  --sub:#7DD3FC; --ok:#4ADE80; --danger:#FF5D5D; --branch:#C084FC;
  --ring-track:rgba(160,178,222,.12);
  --shadow:0 12px 40px rgba(0,0,0,.45), 0 2px 8px rgba(0,0,0,.35);
  --shadow-sm:0 4px 14px rgba(0,0,0,.3);
  --r-lg:20px; --r-md:14px; --r-sm:9px;
  --font-jp:'Zen Kaku Gothic New','Hiragino Sans',sans-serif;
  --font-disp:'Space Grotesk','Zen Kaku Gothic New',sans-serif;
  --font-mono:'IBM Plex Mono','Space Grotesk',monospace;
  --sat: env(safe-area-inset-top,0px); --sab: env(safe-area-inset-bottom,0px);
  --glow:0 0 24px rgba(255,176,46,.35);
}
[data-theme="aurora"]{
  --bg:#070D14; --bg2:#0B121C; --surface:#101A26; --surface2:#152334;
  --accent:#5EEAFF; --accent-ink:#00222B; --accent-soft:rgba(94,234,255,.13);
  --sub:#A78BFA; --branch:#F0ABFC; --glow:0 0 24px rgba(94,234,255,.35);
  --line:rgba(140,200,235,.13); --line2:rgba(140,200,235,.25);
}
[data-theme="velvet"]{
  --bg:#120A16; --bg2:#170E1D; --surface:#1E1326; --surface2:#281A33;
  --accent:#F47CC0; --accent-ink:#2B0418; --accent-soft:rgba(244,124,192,.14);
  --sub:#C4B5FD; --branch:#8BE9FD; --glow:0 0 24px rgba(244,124,192,.35);
  --line:rgba(220,170,230,.13); --line2:rgba(220,170,230,.25);
}
[data-theme="paper"]{
  --bg:#F4F2EC; --bg2:#ECEAE2; --surface:#FFFFFF; --surface2:#F6F4EE;
  --line:rgba(40,46,66,.13); --line2:rgba(40,46,66,.26);
  --text:#1B2030; --text2:#525C75; --text3:#8C94A8;
  --accent:#C2410C; --accent-ink:#FFF6EC; --accent-soft:rgba(194,65,12,.1);
  --sub:#0E7490; --ok:#15803D; --danger:#DC2626; --branch:#7C3AED;
  --ring-track:rgba(40,46,66,.12);
  --shadow:0 12px 36px rgba(40,46,66,.14), 0 2px 8px rgba(40,46,66,.08);
  --shadow-sm:0 4px 12px rgba(40,46,66,.1);
  --glow:0 0 20px rgba(194,65,12,.25);
}
/* ============ Base ============ */
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent}
html,body{height:100%; margin:0; overscroll-behavior:none}
body{
  background:var(--bg); color:var(--text); font-family:var(--font-jp);
  font-size:15px; line-height:1.55; -webkit-font-smoothing:antialiased;
  transition:background .35s ease, color .35s ease;
  touch-action:manipulation;
}
body::before{ /* ambient glow */
  content:""; position:fixed; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(900px 500px at 85% -10%, var(--accent-soft), transparent 60%),
    radial-gradient(700px 480px at -10% 100%, var(--accent-soft), transparent 65%);
  opacity:.7;
}
button{font-family:inherit; cursor:pointer; border:none; background:none; color:inherit; padding:0}
input,textarea,select{font-family:inherit; color:var(--text); background:var(--bg2); border:1px solid var(--line); border-radius:var(--r-sm); padding:10px 12px; font-size:15px; outline:none; width:100%}
input:focus,textarea:focus,select:focus{border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft)}
textarea{resize:vertical; min-height:72px}
::placeholder{color:var(--text3)}
:focus-visible{outline:2px solid var(--accent); outline-offset:2px}
@media (prefers-reduced-motion:reduce){ *,*::before,*::after{animation-duration:.01ms!important; transition-duration:.01ms!important} }

/* ============ Layout / views ============ */
.view{display:none; position:fixed; inset:0; z-index:1; overflow:hidden; flex-direction:column}
.view.active{display:flex; animation:viewIn .32s cubic-bezier(.22,1,.36,1)}
@keyframes viewIn{from{opacity:0; transform:translateY(10px)} to{opacity:1; transform:none}}
.topbar{
  display:flex; align-items:center; gap:10px; padding:calc(10px + var(--sat)) 16px 10px;
  border-bottom:1px solid var(--line); background:color-mix(in srgb, var(--bg) 80%, transparent);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); z-index:30; flex:none;
}
.topbar h1{font-size:16px; font-weight:700; margin:0; letter-spacing:.02em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.brand{font-family:var(--font-disp); font-weight:700; font-size:19px; letter-spacing:.01em; display:flex; align-items:center; gap:9px}
.brand .dot{width:10px; height:10px; border-radius:50%; background:var(--accent); box-shadow:var(--glow); animation:pulse 2.6s ease-in-out infinite}
@keyframes pulse{0%,100%{transform:scale(1); opacity:1} 50%{transform:scale(.78); opacity:.7}}
.spacer{flex:1}

/* ============ Buttons ============ */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:7px;
  padding:10px 16px; border-radius:var(--r-sm); font-size:14px; font-weight:700;
  background:var(--surface); border:1px solid var(--line); color:var(--text);
  transition:transform .15s ease, background .2s, border-color .2s, box-shadow .2s;
  user-select:none; -webkit-user-select:none; min-height:42px;
}
.btn:active{transform:scale(.96)}
.btn:hover{border-color:var(--line2); background:var(--surface2)}
.btn.primary{background:var(--accent); color:var(--accent-ink); border-color:transparent; box-shadow:var(--glow)}
.btn.primary:hover{filter:brightness(1.08)}
.btn.ghost{background:transparent; border-color:transparent}
.btn.ghost:hover{background:var(--surface)}
.btn.danger{color:var(--danger); border-color:color-mix(in srgb, var(--danger) 40%, transparent)}
.btn.danger:hover{background:color-mix(in srgb, var(--danger) 12%, transparent)}
.btn.sm{padding:6px 11px; min-height:32px; font-size:12.5px; border-radius:8px}
.btn.icon{width:42px; padding:0}
.btn.icon.sm{width:32px}
.btn:disabled{opacity:.4; pointer-events:none}
svg.ic{width:18px; height:18px; flex:none; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round}
.btn.sm svg.ic{width:15px; height:15px}

/* ============ Home ============ */
#view-home .scroll{flex:1; overflow-y:auto; padding:18px 16px calc(40px + var(--sab)); position:relative; z-index:1}
.home-wrap{max-width:980px; margin:0 auto}
.hero{margin:6px 0 22px}
.hero .eyebrow{font-family:var(--font-mono); font-size:11px; letter-spacing:.22em; color:var(--accent); text-transform:uppercase; margin-bottom:6px}
.hero h2{font-family:var(--font-disp); font-size:clamp(24px,5vw,34px); margin:0 0 6px; font-weight:700; letter-spacing:-.01em}
.hero p{color:var(--text2); margin:0; font-size:13.5px; max-width:46em}
.section-h{display:flex; align-items:baseline; gap:10px; margin:26px 0 12px}
.section-h h3{font-size:13px; margin:0; letter-spacing:.14em; color:var(--text2); font-weight:700; text-transform:uppercase}
.section-h .line{flex:1; height:1px; background:var(--line)}
.card-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:14px}
.tcard{
  background:var(--surface); border:1px solid var(--line); border-radius:var(--r-lg);
  padding:16px 16px 13px; position:relative; overflow:hidden; cursor:pointer;
  transition:transform .2s cubic-bezier(.22,1,.36,1), border-color .2s, box-shadow .25s;
  box-shadow:var(--shadow-sm);
}
.tcard:hover{transform:translateY(-3px); border-color:var(--line2); box-shadow:var(--shadow)}
.tcard:active{transform:scale(.985)}
.tcard h4{margin:0 0 4px; font-size:16px; font-weight:700; padding-right:30px}
.tcard .meta{display:flex; gap:12px; color:var(--text2); font-size:12px; font-family:var(--font-mono); align-items:center}
.tcard .meta .tt{color:var(--accent); font-weight:600}
.tcard .desc{color:var(--text2); font-size:12.5px; margin:7px 0 0; min-height:1.2em;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
.tcard .bar{display:flex; height:5px; border-radius:3px; overflow:hidden; margin-top:12px; background:var(--ring-track)}
.tcard .bar i{display:block; height:100%}
.tcard .actions{display:flex; gap:6px; margin-top:13px}
.tcard .kebab{position:absolute; top:10px; right:8px; color:var(--text2)}
.tcard.tpl{border-style:dashed}
.tcard.tpl .tplmark{position:absolute; top:14px; right:14px; font-family:var(--font-mono); font-size:10px; letter-spacing:.15em; color:var(--sub); border:1px solid color-mix(in srgb,var(--sub) 45%, transparent); padding:2px 7px; border-radius:99px}
.resume-banner{
  display:flex; align-items:center; gap:13px; background:linear-gradient(120deg, var(--accent-soft), transparent 70%), var(--surface);
  border:1px solid color-mix(in srgb, var(--accent) 45%, transparent); border-radius:var(--r-lg);
  padding:14px 16px; margin-bottom:20px; box-shadow:var(--shadow-sm); animation:viewIn .4s ease;
}
.resume-banner .live{display:flex; align-items:center; gap:7px; font-family:var(--font-mono); font-size:11px; letter-spacing:.2em; color:var(--accent); font-weight:600}
.resume-banner .live i{width:8px; height:8px; border-radius:50%; background:var(--accent); box-shadow:var(--glow); animation:pulse 1.6s infinite}
.resume-banner .info{flex:1; min-width:0}
.resume-banner .info b{display:block; font-size:15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.resume-banner .info span{font-size:12px; color:var(--text2)}
.empty{
  border:1.5px dashed var(--line2); border-radius:var(--r-lg); padding:34px 20px; text-align:center; color:var(--text2);
}
.empty b{display:block; color:var(--text); font-size:15px; margin-bottom:4px}
.empty p{margin:0 0 14px; font-size:13px}
.fab-row{display:flex; gap:10px; flex-wrap:wrap; margin-top:4px}

/* ============ Modal ============ */
.modal-veil{position:fixed; inset:0; background:rgba(4,6,10,.6); backdrop-filter:blur(6px); z-index:200; display:none; align-items:flex-end; justify-content:center}
[data-theme="paper"] .modal-veil{background:rgba(40,46,66,.35)}
.modal-veil.open{display:flex; animation:fadeIn .2s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal{
  background:var(--surface); border:1px solid var(--line2); border-radius:22px 22px 0 0;
  width:100%; max-width:560px; max-height:86vh; overflow-y:auto; padding:20px 20px calc(22px + var(--sab));
  animation:sheetUp .32s cubic-bezier(.22,1,.36,1); box-shadow:var(--shadow);
}
@keyframes sheetUp{from{transform:translateY(50px); opacity:.4} to{transform:none; opacity:1}}
@media(min-width:640px){
  .modal-veil{align-items:center; padding:24px}
  .modal{border-radius:22px; animation:popIn .28s cubic-bezier(.22,1,.36,1)}
  @keyframes popIn{from{transform:scale(.95) translateY(12px); opacity:0} to{transform:none; opacity:1}}
}
.modal h3{margin:0 0 4px; font-size:17px}
.modal .sub{color:var(--text2); font-size:12.5px; margin:0 0 16px}
.field{margin-bottom:14px}
.field label{display:block; font-size:12px; font-weight:700; color:var(--text2); margin-bottom:6px; letter-spacing:.05em}
.row{display:flex; gap:10px}
.row > *{flex:1}
.modal .foot{display:flex; gap:10px; justify-content:flex-end; margin-top:18px}
.seg{display:flex; background:var(--bg2); border:1px solid var(--line); border-radius:10px; padding:3px; gap:3px}
.seg button{flex:1; padding:8px 6px; border-radius:7px; font-size:12.5px; font-weight:700; color:var(--text2); transition:all .18s}
.seg button.on{background:var(--accent); color:var(--accent-ink)}
.toast-wrap{position:fixed; left:0; right:0; bottom:calc(18px + var(--sab)); display:flex; flex-direction:column; align-items:center; gap:8px; z-index:400; pointer-events:none}
.toast{
  background:var(--surface2); border:1px solid var(--line2); color:var(--text); border-radius:99px;
  padding:10px 18px; font-size:13.5px; font-weight:600; box-shadow:var(--shadow); display:flex; gap:8px; align-items:center;
  animation:toastIn .3s cubic-bezier(.22,1,.36,1); pointer-events:auto; max-width:90vw;
}
.toast.out{animation:toastOut .3s ease forwards}
@keyframes toastIn{from{transform:translateY(16px); opacity:0} to{transform:none; opacity:1}}
@keyframes toastOut{to{transform:translateY(10px); opacity:0}}
.toast .ic{color:var(--accent)}
</style>
<style>
/* ============ Editor ============ */
#view-editor{background:var(--bg)}
.ed-body{flex:1; display:flex; position:relative; overflow:hidden}
.canvas-wrap{flex:1; position:relative; overflow:hidden; touch-action:none;
  background-image:radial-gradient(var(--line) 1.1px, transparent 1.1px); background-size:26px 26px;
}
.canvas{position:absolute; left:0; top:0; transform-origin:0 0; will-change:transform}
.edges{position:absolute; left:0; top:0; overflow:visible; pointer-events:none}
.edges path{fill:none; stroke:var(--line2); stroke-width:2.5; pointer-events:stroke; cursor:pointer; transition:stroke .2s}
.edges path:hover{stroke:var(--accent)}
.edges path.br-l{stroke:color-mix(in srgb, var(--branch) 70%, transparent)}
.edges path.br-r{stroke:color-mix(in srgb, var(--sub) 70%, transparent)}
.edges path.pending{stroke:var(--accent); stroke-dasharray:6 6; animation:dashmove 1s linear infinite}
@keyframes dashmove{to{stroke-dashoffset:-12}}
.node{
  position:absolute; width:190px; background:var(--surface); border:1.5px solid var(--line2);
  border-radius:var(--r-md); padding:11px 13px 13px; cursor:grab; user-select:none; -webkit-user-select:none;
  box-shadow:var(--shadow-sm); transition:border-color .2s, box-shadow .2s; touch-action:none;
}
.node:active{cursor:grabbing}
.node.sel{border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft), var(--shadow)}
.node.linkable{border-color:var(--ok); box-shadow:0 0 0 3px color-mix(in srgb,var(--ok) 25%, transparent)}
.node .ntype{font-family:var(--font-mono); font-size:9.5px; letter-spacing:.18em; text-transform:uppercase; margin-bottom:3px; display:flex; align-items:center; gap:6px}
.node .ntype::before{content:""; width:7px; height:7px; border-radius:2px; background:currentColor}
.node[data-type="start"] .ntype{color:var(--ok)}
.node[data-type="section"] .ntype{color:var(--accent)}
.node[data-type="branch"] .ntype{color:var(--branch)}
.node[data-type="end"] .ntype{color:var(--danger)}
.node h5{margin:0; font-size:14px; font-weight:700; line-height:1.35; word-break:break-word}
.node .ntime{font-family:var(--font-mono); font-size:12px; color:var(--text2); margin-top:5px; display:flex; align-items:center; gap:6px}
.node .ntime b{color:var(--text)}
.node .nmemo{font-size:11px; color:var(--text3); margin-top:4px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
.node .tbar{height:4px; border-radius:2px; background:var(--ring-track); margin-top:9px; overflow:hidden}
.node .tbar i{display:block; height:100%; background:var(--accent); border-radius:2px}
.node[data-type="branch"] .tbar i{background:var(--branch)}
.port{
  position:absolute; width:22px; height:22px; border-radius:50%; background:var(--surface2);
  border:2px solid var(--line2); bottom:-12px; left:50%; transform:translateX(-50%);
  display:flex; align-items:center; justify-content:center; cursor:crosshair; transition:all .18s; z-index:3;
}
.port::after{content:""; width:7px; height:7px; border-radius:50%; background:var(--text3); transition:background .18s}
.port:hover, .port.pending{border-color:var(--accent); transform:translateX(-50%) scale(1.18)}
.port:hover::after, .port.pending::after{background:var(--accent)}
.port.l{left:26%} .port.r{left:74%}
.port.l::after{background:var(--branch)} .port.r::after{background:var(--sub)}
.port .plabel{position:absolute; top:23px; font-family:var(--font-mono); font-size:9px; color:var(--text3); letter-spacing:.1em; white-space:nowrap}
.ed-toolbar{
  position:absolute; left:50%; transform:translateX(-50%); bottom:calc(16px + var(--sab));
  display:flex; gap:8px; background:color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter:blur(14px);
  border:1px solid var(--line2); padding:8px; border-radius:16px; box-shadow:var(--shadow); z-index:40;
}
.ed-toolbar .btn{min-height:40px}
.zoomctl{position:absolute; right:14px; bottom:calc(16px + var(--sab)); display:flex; flex-direction:column; gap:6px; z-index:40}
.zoomctl .btn{background:color-mix(in srgb, var(--surface) 90%, transparent); backdrop-filter:blur(10px)}
.ed-hint{position:absolute; top:12px; left:50%; transform:translateX(-50%); background:var(--surface2); border:1px solid var(--accent); color:var(--text); font-size:12.5px; padding:8px 16px; border-radius:99px; z-index:50; box-shadow:var(--shadow); display:flex; gap:10px; align-items:center; animation:toastIn .25s ease; max-width:92vw}

/* timeline drawer */
.tl-drawer{
  width:264px; flex:none; border-left:1px solid var(--line); background:var(--bg2);
  display:flex; flex-direction:column; overflow:hidden; transition:margin-right .3s cubic-bezier(.22,1,.36,1);
}
.tl-drawer.closed{margin-right:-264px}
.tl-head{padding:13px 16px 10px; border-bottom:1px solid var(--line)}
.tl-head h4{margin:0 0 2px; font-size:12px; letter-spacing:.14em; color:var(--text2); text-transform:uppercase}
.tl-total{font-family:var(--font-mono); font-size:22px; font-weight:600}
.tl-total .lim{font-size:12px; color:var(--text3)}
.tl-total.over{color:var(--danger)}
.tl-scroll{flex:1; overflow-y:auto; padding:12px 14px 24px}
.tl-row{display:flex; gap:10px; margin-bottom:2px; cursor:pointer; border-radius:8px; padding:4px 6px}
.tl-row:hover{background:var(--surface)}
.tl-row.cur{background:var(--accent-soft)}
.tl-rail{width:34px; flex:none; display:flex; flex-direction:column; align-items:center}
.tl-rail .tick{font-family:var(--font-mono); font-size:9.5px; color:var(--text3)}
.tl-rail .seg{flex:1; width:5px; border-radius:3px; margin:3px 0; min-height:14px}
.tl-info{flex:1; min-width:0; padding-top:1px}
.tl-info b{display:block; font-size:12.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.tl-info span{font-family:var(--font-mono); font-size:10.5px; color:var(--text2)}
.tl-warn{font-size:11px; color:var(--danger); padding:2px 6px}
.clock-chip{font-family:var(--font-mono); font-size:12px; color:var(--text2); border:1px solid var(--line); border-radius:99px; padding:4px 10px}

/* inspector sheet */
.inspector{
  position:absolute; left:0; right:0; bottom:0; z-index:60;
  background:var(--surface); border-top:1px solid var(--line2); border-radius:20px 20px 0 0;
  box-shadow:0 -14px 40px rgba(0,0,0,.4); transform:translateY(105%); transition:transform .32s cubic-bezier(.22,1,.36,1);
  max-height:72%; display:flex; flex-direction:column;
}
.inspector.open{transform:none}
.insp-grip{width:42px; height:4.5px; border-radius:3px; background:var(--line2); margin:9px auto 2px; flex:none}
.insp-head{display:flex; align-items:center; gap:10px; padding:6px 16px 10px; border-bottom:1px solid var(--line); flex:none}
.insp-head .ntype{font-family:var(--font-mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase}
.insp-body{overflow-y:auto; padding:14px 16px calc(20px + var(--sab))}
@media(min-width:900px){
  .inspector{left:auto; right:0; top:0; bottom:0; width:340px; max-height:none; border-radius:0; border-left:1px solid var(--line2); border-top:none; transform:translateX(105%)}
  .inspector.open{transform:none}
  .insp-grip{display:none}
}
.timewheel{display:flex; align-items:center; gap:8px}
.timewheel input{text-align:center; font-family:var(--font-mono); font-size:18px; padding:8px 4px}
.timewheel .colon{font-family:var(--font-mono); font-size:18px; color:var(--text2)}
.steppers{display:flex; gap:6px; margin-top:8px; flex-wrap:wrap}
.chip{font-size:11.5px; font-weight:700; border:1px solid var(--line2); border-radius:99px; padding:5px 11px; color:var(--text2); transition:all .15s; background:var(--bg2)}
.chip:hover{color:var(--text); border-color:var(--accent)}
.chip:active{transform:scale(.93)}
.tglrow{display:flex; align-items:center; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--line)}
.tglrow span{font-size:13.5px}
.tgl{width:46px; height:27px; border-radius:99px; background:var(--bg2); border:1px solid var(--line2); position:relative; transition:background .2s; flex:none}
.tgl::after{content:""; position:absolute; width:21px; height:21px; border-radius:50%; background:var(--text3); top:2px; left:2px; transition:all .2s cubic-bezier(.22,1,.36,1)}
.tgl.on{background:var(--accent); border-color:transparent}
.tgl.on::after{left:21px; background:var(--accent-ink)}
.memo-tpls{display:flex; gap:6px; flex-wrap:wrap; margin-top:7px}
</style>
<style>
/* ============ Run view ============ */
#view-run{background:radial-gradient(1100px 700px at 50% -20%, var(--accent-soft), transparent 55%), var(--bg)}
.run-top{display:flex; align-items:center; gap:10px; padding:calc(10px + var(--sat)) 14px 8px; flex:none; z-index:5}
.onair{display:flex; align-items:center; gap:8px; font-family:var(--font-mono); font-size:11px; letter-spacing:.24em; font-weight:600; color:var(--accent); border:1px solid color-mix(in srgb,var(--accent) 45%, transparent); border-radius:99px; padding:5px 13px; background:var(--accent-soft)}
.onair i{width:8px; height:8px; border-radius:50%; background:var(--accent); box-shadow:var(--glow); animation:pulse 1.5s infinite}
.onair.paused{color:var(--sub); border-color:color-mix(in srgb,var(--sub) 45%, transparent); background:color-mix(in srgb,var(--sub) 12%, transparent)}
.onair.paused i{background:var(--sub); animation:none; box-shadow:none}
.run-clock{font-family:var(--font-mono); font-size:12px; color:var(--text3)}
.run-main{flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:0 22px; min-height:0; position:relative; z-index:1; gap:0}
.run-sec-label{font-family:var(--font-mono); font-size:11.5px; letter-spacing:.26em; color:var(--text3); text-transform:uppercase; margin-bottom:8px}
.run-title{font-size:clamp(24px,6.4vw,44px); font-weight:900; text-align:center; line-height:1.22; margin:0 0 4vh; letter-spacing:.01em; text-wrap:balance; animation:viewIn .4s ease}
.run-count{
  font-family:var(--font-mono); font-weight:600; font-size:clamp(64px,21vw,150px); line-height:1;
  letter-spacing:-.01em; font-variant-numeric:tabular-nums; text-align:center; position:relative;
  text-shadow:0 0 50px var(--accent-soft); transition:color .3s;
}
.run-count.warn{color:var(--accent); animation:countWarn 1s ease-in-out infinite}
.run-count.crit{color:var(--danger); animation:countWarn .55s ease-in-out infinite}
@keyframes countWarn{0%,100%{opacity:1} 50%{opacity:.55}}
.run-count .dsec{font-size:.38em; color:var(--text3); font-weight:500}
.run-next{display:flex; align-items:center; gap:9px; margin-top:3.5vh; color:var(--text2); font-size:13.5px; background:var(--surface); border:1px solid var(--line); border-radius:99px; padding:7px 16px; max-width:88vw}
.run-next .lbl{font-family:var(--font-mono); font-size:10px; letter-spacing:.2em; color:var(--text3); flex:none}
.run-next b{color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.run-hint{
  margin-top:2.6vh; max-width:680px; width:100%; text-align:center; font-size:clamp(15px,4.2vw,21px); font-weight:700; line-height:1.6;
  color:var(--text); background:linear-gradient(180deg, color-mix(in srgb, var(--surface) 85%, transparent), color-mix(in srgb, var(--surface2) 85%, transparent));
  border:1px solid var(--line); border-left:3px solid var(--sub); border-radius:var(--r-md); padding:13px 18px;
  backdrop-filter:blur(8px); animation:viewIn .45s ease;
}
.run-hint .memo{display:block; font-size:.72em; font-weight:500; color:var(--text2); margin-top:5px; line-height:1.5}
.run-hint:empty{display:none}
/* sub ring */
.subring{position:relative; width:108px; height:108px; flex:none}
.subring svg{transform:rotate(-90deg); width:100%; height:100%; overflow:visible}
.subring circle{fill:none; stroke-width:7; stroke-linecap:round}
.subring .track{stroke:var(--ring-track)}
.subring .prog{stroke:var(--accent); filter:drop-shadow(0 0 8px var(--accent-soft)); transition:stroke .3s}
.subring .prog.crit{stroke:var(--danger)}
.subring .inner{position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:var(--font-mono)}
.subring .pct{font-size:21px; font-weight:600; line-height:1}
.subring .plbl{font-size:8.5px; letter-spacing:.18em; color:var(--text3); margin-top:3px}
.run-bottom{flex:none; display:flex; align-items:flex-end; gap:14px; padding:10px 16px calc(14px + var(--sab)); z-index:5}
.run-ctl{flex:1; display:flex; justify-content:center; gap:12px}
.rbtn{
  width:58px; height:58px; border-radius:50%; background:var(--surface); border:1px solid var(--line2);
  display:flex; align-items:center; justify-content:center; transition:all .18s; box-shadow:var(--shadow-sm);
}
.rbtn:active{transform:scale(.9)}
.rbtn:hover{border-color:var(--accent)}
.rbtn.big{width:72px; height:72px; background:var(--accent); color:var(--accent-ink); border:none; box-shadow:var(--glow)}
.rbtn svg.ic{width:24px; height:24px}
.rbtn.big svg.ic{width:30px; height:30px}
/* minimap */
.minimap{
  width:108px; height:78px; flex:none; background:color-mix(in srgb, var(--surface) 85%, transparent); border:1px solid var(--line2);
  border-radius:12px; overflow:hidden; cursor:pointer; position:relative; backdrop-filter:blur(8px); transition:border-color .2s;
}
.minimap:hover{border-color:var(--accent)}
.minimap svg{width:100%; height:100%}
.minimap .mlbl{position:absolute; bottom:3px; left:0; right:0; text-align:center; font-family:var(--font-mono); font-size:8px; letter-spacing:.14em; color:var(--text3)}
/* ready phase */
.ready-card{max-width:520px; width:100%; background:var(--surface); border:1px solid var(--line2); border-radius:var(--r-lg); padding:26px 22px; box-shadow:var(--shadow); text-align:center; animation:viewIn .4s ease}
.ready-card .eyebrow{font-family:var(--font-mono); font-size:11px; letter-spacing:.24em; color:var(--ok); margin-bottom:8px}
.ready-card h2{margin:0 0 4px; font-size:24px; font-weight:900}
.ready-card .tot{font-family:var(--font-mono); color:var(--text2); font-size:13px; margin-bottom:18px}
.ready-checks{display:flex; gap:8px; justify-content:center; margin:0 0 20px; flex-wrap:wrap}
.go-btn{
  width:148px; height:148px; border-radius:50%; background:var(--accent); color:var(--accent-ink); font-size:20px; font-weight:900;
  letter-spacing:.1em; box-shadow:var(--glow), 0 16px 40px rgba(0,0,0,.4); transition:transform .2s; position:relative; margin:0 auto 8px; display:block;
}
.go-btn::before{content:""; position:absolute; inset:-10px; border-radius:50%; border:1.5px solid color-mix(in srgb, var(--accent) 50%, transparent); animation:ringping 2s ease-out infinite}
@keyframes ringping{0%{transform:scale(.92); opacity:1} 100%{transform:scale(1.18); opacity:0}}
.go-btn:active{transform:scale(.93)}
/* branch overlay */
.branch-veil{position:absolute; inset:0; z-index:80; display:none; flex-direction:column; align-items:center; justify-content:center; padding:22px; background:color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter:blur(14px)}
.branch-veil.open{display:flex; animation:fadeIn .25s ease}
.bq-label{font-family:var(--font-mono); font-size:11px; letter-spacing:.26em; color:var(--branch); margin-bottom:10px}
.bq{font-size:clamp(22px,5.6vw,34px); font-weight:900; text-align:center; margin:0 0 5vh; text-wrap:balance; max-width:620px}
.b-opts{display:flex; gap:14px; width:100%; max-width:640px; align-items:stretch}
.b-card{
  flex:1; background:var(--surface); border:1.5px solid var(--line2); border-radius:var(--r-lg); padding:20px 14px 17px;
  text-align:center; cursor:pointer; transition:all .2s cubic-bezier(.22,1,.36,1); position:relative; overflow:hidden; min-height:118px;
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
}
.b-card .arr{font-family:var(--font-mono); font-size:20px; line-height:1}
.b-card.l .arr{color:var(--branch)} .b-card.r .arr{color:var(--sub)}
.b-card b{font-size:17px; line-height:1.35}
.b-card .to{font-size:11.5px; color:var(--text3); font-family:var(--font-mono)}
.b-card.hot{transform:scale(1.04); border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft), var(--shadow)}
.b-card .defmark{position:absolute; top:8px; right:10px; font-family:var(--font-mono); font-size:9px; letter-spacing:.12em; color:var(--text3); border:1px solid var(--line2); padding:2px 6px; border-radius:99px}
.b-slider{width:min(380px,86vw); margin-top:5vh; position:relative; height:62px; border-radius:99px; background:var(--surface); border:1px solid var(--line2); display:flex; align-items:center; justify-content:space-between; padding:0 22px; font-size:12px; color:var(--text3); user-select:none}
.b-slider .knob{
  position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:52px; height:52px; border-radius:50%;
  background:var(--accent); color:var(--accent-ink); display:flex; align-items:center; justify-content:center;
  box-shadow:var(--glow); cursor:grab; touch-action:none; transition:box-shadow .2s; z-index:2;
}
.b-slider .knob:active{cursor:grabbing}
.b-timeout{margin-top:18px; display:flex; align-items:center; gap:10px; font-family:var(--font-mono); font-size:12px; color:var(--text2)}
.b-timeout .bar{width:150px; height:4px; border-radius:2px; background:var(--ring-track); overflow:hidden}
.b-timeout .bar i{display:block; height:100%; background:var(--branch); transition:width .2s linear}
/* flash alarm */
.flash{position:fixed; inset:0; z-index:500; pointer-events:none; opacity:0; background:var(--accent)}
.flash.go{animation:flashAnim .9s ease-out}
@keyframes flashAnim{0%{opacity:.55} 100%{opacity:0}}
/* finish */
.finish-wrap{flex:1; overflow-y:auto; padding:24px 18px calc(40px + var(--sab)); display:flex; flex-direction:column; align-items:center}
.finish-hero{text-align:center; margin:4vh 0 26px; animation:viewIn .5s ease}
.finish-hero .ok-ring{width:92px; height:92px; border-radius:50%; border:3px solid var(--ok); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; color:var(--ok); animation:popIn2 .6s cubic-bezier(.22,1.4,.36,1)}
@keyframes popIn2{from{transform:scale(.4); opacity:0} to{transform:none; opacity:1}}
.finish-hero h2{font-size:28px; margin:0 0 4px; font-weight:900}
.finish-hero .ft{font-family:var(--font-mono); color:var(--text2); font-size:14px}
.sum-card{width:100%; max-width:560px; background:var(--surface); border:1px solid var(--line); border-radius:var(--r-lg); padding:18px; margin-bottom:14px; box-shadow:var(--shadow-sm)}
.sum-card h4{margin:0 0 12px; font-size:12px; letter-spacing:.14em; color:var(--text2); text-transform:uppercase}
.sum-row{display:flex; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid var(--line); font-size:13px}
.sum-row:last-child{border-bottom:none}
.sum-row .nm{flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.sum-row .tm{font-family:var(--font-mono); font-size:12px; color:var(--text2)}
.sum-row .diff{font-family:var(--font-mono); font-size:11.5px; width:58px; text-align:right}
.diff.over{color:var(--danger)} .diff.under{color:var(--ok)}
.sum-row .bch{font-size:11px; color:var(--branch); border:1px solid color-mix(in srgb,var(--branch) 40%, transparent); padding:1px 7px; border-radius:99px}
/* chart view (run) */
#view-chart{background:var(--bg)}
.chart-body{flex:1; position:relative; overflow:hidden; touch-action:none; background-image:radial-gradient(var(--line) 1.1px, transparent 1.1px); background-size:26px 26px}
.chart-canvas{position:absolute; transform-origin:0 0}
.cnode{position:absolute; width:190px; background:var(--surface); border:1.5px solid var(--line2); border-radius:var(--r-md); padding:10px 13px; opacity:.55; transition:all .3s}
.cnode.passed{opacity:.85; border-color:color-mix(in srgb, var(--ok) 55%, transparent)}
.cnode.passed .ntype{color:var(--ok)!important}
.cnode.cur{opacity:1; border-color:var(--accent); box-shadow:0 0 0 4px var(--accent-soft), var(--glow); animation:curPulse 2s ease-in-out infinite}
@keyframes curPulse{0%,100%{box-shadow:0 0 0 4px var(--accent-soft)} 50%{box-shadow:0 0 0 8px transparent}}
.cnode.nxt{opacity:.95; border-style:dashed; border-color:var(--sub)}
.cnode .cprog{height:4px; border-radius:2px; background:var(--ring-track); margin-top:8px; overflow:hidden}
.cnode .cprog i{display:block; height:100%; background:var(--accent)}
.chart-foot{flex:none; border-top:1px solid var(--line); padding:10px 16px calc(12px + var(--sab)); display:flex; gap:14px; align-items:center; font-family:var(--font-mono); font-size:12px; color:var(--text2); overflow-x:auto}
.chart-foot .seg2{display:flex; align-items:center; gap:6px; white-space:nowrap}
.chart-foot .sw{width:9px; height:9px; border-radius:3px}
.tlbar{flex:1; min-width:140px; height:8px; border-radius:4px; background:var(--ring-track); overflow:hidden; display:flex}
.tlbar i{height:100%; display:block}
/* settings list */
.set-group{background:var(--surface); border:1px solid var(--line); border-radius:var(--r-md); padding:4px 16px; margin-bottom:14px}
.theme-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); gap:10px; margin:8px 0 14px}
.theme-card{border:2px solid var(--line2); border-radius:var(--r-md); padding:10px; cursor:pointer; transition:all .2s; text-align:left}
.theme-card.on{border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft)}
.theme-card .sw-row{display:flex; gap:5px; margin-bottom:7px}
.theme-card .sw-row i{width:16px; height:16px; border-radius:5px}
.theme-card b{font-size:12px}
input[type=range]{appearance:none; -webkit-appearance:none; height:6px; border-radius:3px; background:var(--ring-track); padding:0; border:none}
input[type=range]::-webkit-slider-thumb{appearance:none; -webkit-appearance:none; width:22px; height:22px; border-radius:50%; background:var(--accent); box-shadow:var(--shadow-sm); cursor:pointer}
input[type=color]{padding:2px; height:40px; cursor:pointer}
.kbd{font-family:var(--font-mono); font-size:10.5px; border:1px solid var(--line2); border-bottom-width:2px; border-radius:5px; padding:1px 6px; color:var(--text2)}
@media(max-width:700px){
  .run-ctl{gap:10px}
  .rbtn{width:54px; height:54px}
  .rbtn.big{width:66px; height:66px}
  .subring{width:86px; height:86px}
  .subring .pct{font-size:17px}
  .minimap{width:92px; height:66px}
}
@media(max-height:620px){ .run-title{margin-bottom:2vh} .run-hint{margin-top:1.6vh} }
</style>
</head>
<body data-theme="signal">
<div class="flash" id="flash"></div>
<div class="toast-wrap" id="toasts"></div>

<!-- ============ HOME ============ -->
<section class="view" id="view-home">
  <div class="topbar">
    <div class="brand"><span class="dot"></span>PitchWatch</div>
    <div class="spacer"></div>
    <button class="btn ghost icon" id="btn-settings" title="設定" aria-label="設定"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></button>
  </div>
  <div class="scroll"><div class="home-wrap" id="home-content"></div></div>
</section>

<!-- ============ EDITOR ============ -->
<section class="view" id="view-editor">
  <div class="topbar">
    <button class="btn ghost icon" id="ed-back" aria-label="ホームへ戻る"><svg class="ic" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
    <h1 id="ed-title" contenteditable="true" spellcheck="false" style="outline:none; min-width:60px; border-bottom:1px dashed transparent" title="タップして名前を変更"></h1>
    <div class="spacer"></div>
    <span class="clock-chip" id="ed-clock" style="display:none"></span>
    <button class="btn ghost icon sm" id="ed-undo" title="元に戻す" aria-label="元に戻す"><svg class="ic" viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-15-6.7L3 13"/></svg></button>
    <button class="btn ghost icon sm" id="ed-tl" title="時間軸を表示" aria-label="時間軸"><svg class="ic" viewBox="0 0 24 24"><path d="M12 2v20M17 7l-5-5-5 5M7 17l5 5 5-5"/></svg></button>
    <button class="btn primary sm" id="ed-run"><svg class="ic" viewBox="0 0 24 24"><polygon points="6 3 20 12 6 21 6 3" fill="currentColor" stroke="none"/></svg>本番</button>
  </div>
  <div class="ed-body">
    <div class="canvas-wrap" id="canvas-wrap">
      <div class="canvas" id="canvas">
        <svg class="edges" id="edges" width="1" height="1"></svg>
        <div id="nodes-layer"></div>
      </div>
      <div class="ed-toolbar">
        <button class="btn sm" data-add="section"><svg class="ic" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/></svg>セクション</button>
        <button class="btn sm" data-add="branch"><svg class="ic" viewBox="0 0 24 24"><path d="M6 3v6a6 6 0 0 0 6 6 6 6 0 0 1 6-6V3M12 15v6"/></svg>分岐</button>
        <button class="btn sm" data-add="end"><svg class="ic" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>終了</button>
      </div>
      <div class="zoomctl">
        <button class="btn icon sm" id="zoom-in" aria-label="拡大">＋</button>
        <button class="btn icon sm" id="zoom-out" aria-label="縮小">－</button>
        <button class="btn icon sm" id="zoom-fit" aria-label="全体表示" title="全体表示"><svg class="ic" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg></button>
      </div>
      <div id="ed-hint" style="display:none"></div>
    </div>
    <aside class="tl-drawer closed" id="tl-drawer">
      <div class="tl-head">
        <h4>時間軸 Timeline</h4>
        <div class="tl-total" id="tl-total">0:00</div>
      </div>
      <div class="tl-scroll" id="tl-list"></div>
    </aside>
    <div class="inspector" id="inspector">
      <div class="insp-grip"></div>
      <div class="insp-head">
        <span class="ntype" id="insp-type"></span>
        <div class="spacer"></div>
        <button class="btn sm" id="insp-dup"><svg class="ic" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>複製</button>
        <button class="btn sm danger" id="insp-del"><svg class="ic" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>削除</button>
        <button class="btn ghost icon sm" id="insp-close" aria-label="閉じる">✕</button>
      </div>
      <div class="insp-body" id="insp-body"></div>
    </div>
  </div>
</section>
<!-- ============ RUN ============ -->
<section class="view" id="view-run">
  <div class="run-top">
    <button class="btn ghost icon" id="run-exit" aria-label="終了して戻る"><svg class="ic" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
    <div class="onair" id="onair"><i></i><span>ON AIR</span></div>
    <div class="spacer"></div>
    <span class="run-clock" id="run-clock"></span>
    <button class="btn ghost icon sm" id="run-mute" aria-label="サウンド切替"></button>
    <button class="btn ghost icon sm" id="run-fs" aria-label="フルスクリーン"><svg class="ic" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg></button>
  </div>
  <div class="run-main" id="run-main"></div>
  <div class="run-bottom" id="run-bottom">
    <div class="subring" id="subring"></div>
    <div class="run-ctl" id="run-ctl"></div>
    <div class="minimap" id="minimap" title="ダブルタップで全体チャート"></div>
  </div>
  <div class="branch-veil" id="branch-veil"></div>
</section>

<!-- ============ RUN CHART (read-only) ============ -->
<section class="view" id="view-chart">
  <div class="topbar">
    <button class="btn ghost icon" id="chart-back" aria-label="本番画面に戻る"><svg class="ic" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
    <h1>進行チャート <span style="font-size:11px;color:var(--text3);font-weight:500">読み取り専用</span></h1>
    <div class="spacer"></div>
    <span class="clock-chip" id="chart-remain"></span>
  </div>
  <div class="chart-body" id="chart-body"><div class="chart-canvas" id="chart-canvas"></div></div>
  <div class="chart-foot" id="chart-foot"></div>
</section>

<!-- ============ Modal ============ -->
<div class="modal-veil" id="modal-veil"><div class="modal" id="modal"></div></div>
<input type="file" id="file-input" accept=".json,.pitchwatch,application/json" style="display:none" multiple>

<script>
'use strict';
/* ================================================================
   PitchWatch — single-file app
   storage: localStorage (pw.v1.*) / export: JSON file
================================================================ */
const $=(s,el=document)=>el.querySelector(s);
const $$=(s,el=document)=>[...el.querySelectorAll(s)];
const uid=()=>Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-4);
const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const now=()=>Date.now();
function fmt(sec,opt={}){
  sec=Math.max(0,sec);
  const ds=opt.ds? Math.floor((sec*10)%10):null;
  const s=Math.floor(sec)%60, m=Math.floor(sec/60)%60, h=Math.floor(sec/3600);
  const p=n=>String(n).padStart(2,'0');
  let core=h>0? `${h}:${p(m)}:${p(s)}` : `${m}:${p(s)}`;
  return {core, ds};
}
function fmtS(sec){const f=fmt(sec);return f.core}
function debounce(fn,ms){let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),ms)}}

/* ---------------- storage ---------------- */
const LS={timers:'pw.v1.timers', settings:'pw.v1.settings', session:'pw.v1.session', seen:'pw.v1.seen'};
function load(k,fb){try{const v=localStorage.getItem(k); return v?JSON.parse(v):fb}catch(e){console.warn('load fail',k,e); return fb}}
function save(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){toast('保存に失敗しました（容量不足の可能性）','warn')}}

let DB={timers:load(LS.timers,{})};
let SET=Object.assign({theme:'signal',accent:'',sound:true,volume:.7,vibe:true,flash:true,clock:true,precision:'s'},load(LS.settings,{}));
let SESSION=load(LS.session,null);
const persistTimers=debounce(()=>save(LS.timers,DB.timers),300);
function persistSettings(){save(LS.settings,SET)}
function persistSession(){SESSION?save(LS.session,SESSION):localStorage.removeItem(LS.session)}

/* ---------------- theme ---------------- */
const THEMES={
  signal:{name:'Signal',c:['#0B0D13','#FFB02E','#7DD3FC']},
  aurora:{name:'Aurora',c:['#070D14','#5EEAFF','#A78BFA']},
  velvet:{name:'Velvet',c:['#120A16','#F47CC0','#C4B5FD']},
  paper:{name:'Paper',c:['#F4F2EC','#C2410C','#0E7490']},
};
function applyTheme(){
  document.body.dataset.theme=SET.theme in THEMES?SET.theme:'signal';
  document.body.style.setProperty('--accent', SET.accent||'');
  if(SET.accent){
    document.body.style.setProperty('--accent-soft', SET.accent+'24');
    document.body.style.setProperty('--glow', `0 0 24px ${SET.accent}59`);
  }else{
    document.body.style.removeProperty('--accent');
    document.body.style.removeProperty('--accent-soft');
    document.body.style.removeProperty('--glow');
  }
  $('meta[name=theme-color]').content=getComputedStyle(document.body).getPropertyValue('--bg').trim()||'#0B0D13';
}

/* ---------------- toast ---------------- */
function toast(msg,kind){
  const el=document.createElement('div'); el.className='toast';
  el.innerHTML=(kind==='warn'?'<svg class="ic" viewBox="0 0 24 24" style="color:var(--danger)"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/></svg>':'<svg class="ic" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>')+esc(msg);
  $('#toasts').appendChild(el);
  setTimeout(()=>{el.classList.add('out'); setTimeout(()=>el.remove(),320)},2600);
}

/* ---------------- audio / alarm ---------------- */
let AC=null;
function ac(){ if(!AC){ try{AC=new (window.AudioContext||window.webkitAudioContext)()}catch(e){} } if(AC&&AC.state==='suspended')AC.resume(); return AC }
function beep(pattern='node'){
  if(!SET.sound) return;
  const ctx=ac(); if(!ctx) return;
  const seqs={
    node:[[880,.0,.14],[1175,.16,.18]],
    end:[[660,0,.16],[880,.18,.16],[1320,.36,.34]],
    branch:[[988,0,.1],[988,.14,.1],[1319,.28,.22]],
    tick:[[1175,0,.07]],
    warn:[[523,0,.12],[523,.16,.12]],
  };
  (seqs[pattern]||seqs.node).forEach(([f,t,d])=>{
    const o=ctx.createOscillator(), g=ctx.createGain();
    o.type='sine'; o.frequency.value=f;
    g.gain.setValueAtTime(0,ctx.currentTime+t);
    g.gain.linearRampToValueAtTime(.55*SET.volume,ctx.currentTime+t+.015);
    g.gain.exponentialRampToValueAtTime(.001,ctx.currentTime+t+d);
    o.connect(g).connect(ctx.destination);
    o.start(ctx.currentTime+t); o.stop(ctx.currentTime+t+d+.05);
  });
}
function vibe(ms){ if(SET.vibe && navigator.vibrate){ try{navigator.vibrate(ms)}catch(e){} } }
function flash(){ if(!SET.flash)return; const f=$('#flash'); f.classList.remove('go'); void f.offsetWidth; f.classList.add('go'); }
function fireAlarm(node,kind='node'){
  const a=node?.alarm||{sound:true,vibe:true,flash:true};
  if(a.sound!==false) beep(kind);
  if(a.vibe!==false) vibe(kind==='end'?[120,80,120,80,260]:[90,60,140]);
  if(a.flash!==false) flash();
}

/* ---------------- wake lock ---------------- */
let wakeLock=null;
async function keepAwake(on){
  try{
    if(on && 'wakeLock' in navigator){ wakeLock=await navigator.wakeLock.request('screen'); }
    else if(!on && wakeLock){ await wakeLock.release(); wakeLock=null; }
  }catch(e){}
}
document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible' && SESSION && SESSION.status!=='finished') keepAwake(true) });
</script>
<script>
/* ================================================================
   Data model
================================================================ */
function newNode(type,x,y){
  const base={id:uid(),type,x:Math.round(x),y:Math.round(y),title:'',sec:60,memo:'',hint:'',next:null,alarm:{sound:true,vibe:true,flash:true}};
  if(type==='start'){base.title='開始'; base.sec=0}
  if(type==='end'){base.title='終了'; base.sec=0}
  if(type==='section'){base.title='新しいセクション'}
  if(type==='branch'){Object.assign(base,{title:'分岐',question:'予定通り続ける？',sec:0,waitSec:10,def:'left',left:{label:'続ける',next:null},right:{label:'短縮する',next:null}})}
  return base;
}
function newTimer(name){
  const s=newNode('start',80,60), a=newNode('section',80,200), e=newNode('end',80,360);
  a.title='オープニング'; a.sec=60; a.hint='つかみの一言。会場を見渡して、ゆっくり。';
  s.next=a.id; a.next=e.id;
  return {id:uid(),name:name||'新しいピッチ',desc:'',targetSec:0,createdAt:now(),updatedAt:now(),nodes:[s,a,e],lastRun:null};
}
function nodeOf(t,id){return t.nodes.find(n=>n.id===id)}
function startNode(t){return t.nodes.find(n=>n.type==='start')}
/* default main path (branch -> default side), cycle-safe */
function mainPath(t){
  const path=[]; const seen=new Set(); let cur=startNode(t);
  while(cur && !seen.has(cur.id)){
    seen.add(cur.id); path.push(cur);
    if(cur.type==='end') break;
    const nid=cur.type==='branch'? (cur[cur.def||'left']?.next):cur.next;
    cur=nid?nodeOf(t,nid):null;
  }
  return path;
}
function totalSec(t){return mainPath(t).reduce((a,n)=>a+(n.type==='branch'?(n.waitSec||0):(n.sec||0)),0)}
function validateTimer(t){
  const warns=[];
  if(!startNode(t)) warns.push('開始ノードがありません');
  const p=mainPath(t);
  if(!p.some(n=>n.type==='end')) warns.push('既定ルートが終了ノードに到達しません');
  t.nodes.forEach(n=>{
    if(n.type==='section'&&!n.next) warns.push(`「${n.title||'無題'}」の接続先がありません`);
    if(n.type==='branch'&&(!n.left?.next||!n.right?.next)) warns.push(`分岐「${n.question||n.title}」に未接続の選択肢があります`);
  });
  return warns;
}
/* sanity-check imported data */
function sanitizeTimer(raw){
  if(!raw||typeof raw!=='object'||!Array.isArray(raw.nodes)) throw new Error('タイマー形式ではありません');
  const t={id:uid(),name:String(raw.name||'読み込んだタイマー').slice(0,80),desc:String(raw.desc||'').slice(0,200),
    targetSec:Number(raw.targetSec)||0,createdAt:now(),updatedAt:now(),lastRun:null,nodes:[]};
  const idmap={};
  raw.nodes.forEach(rn=>{
    if(!rn||!['start','section','branch','end'].includes(rn.type)) return;
    const n=newNode(rn.type,Number(rn.x)||0,Number(rn.y)||0);
    idmap[rn.id]=n.id;
    n.title=String(rn.title||n.title).slice(0,120);
    n.sec=clamp(Number(rn.sec)||0,0,36000);
    n.memo=String(rn.memo||'').slice(0,600); n.hint=String(rn.hint||'').slice(0,600);
    n.alarm=Object.assign({sound:true,vibe:true,flash:true},rn.alarm||{});
    n._next=rn.next;
    if(rn.type==='branch'){
      n.question=String(rn.question||'').slice(0,200);
      n.waitSec=clamp(Number(rn.waitSec)||10,3,600);
      n.def=rn.def==='right'?'right':'left';
      n.left={label:String(rn.left?.label||'はい').slice(0,40),_next:rn.left?.next};
      n.right={label:String(rn.right?.label||'いいえ').slice(0,40),_next:rn.right?.next};
    }
    t.nodes.push(n);
  });
  t.nodes.forEach(n=>{
    n.next=idmap[n._next]||null; delete n._next;
    if(n.type==='branch'){
      n.left.next=idmap[n.left._next]||null; delete n.left._next;
      n.right.next=idmap[n.right._next]||null; delete n.right._next;
    }
  });
  if(!t.nodes.some(n=>n.type==='start')) throw new Error('開始ノードが含まれていません');
  return t;
}

/* ---------------- built-in templates ---------------- */
function buildTemplates(){
  const T=[];
  { // 3min pitch with demo branch
    const t=newTimer('3分ピッチ（デモ分岐つき）'); t.nodes=[]; t.desc='コンテスト定番の3分構成。デモ失敗時のバックアッププラン込み。'; t.targetSec=180;
    const N=(type,x,y,p)=>{const n=Object.assign(newNode(type,x,y),p); t.nodes.push(n); return n};
    const s=N('start',60,40);
    const hook=N('section',60,170,{title:'フック',sec:15,hint:'「もし◯◯が一瞬で終わるとしたら？」',memo:'視線を上げて、ゆっくり大きく。'});
    const prob=N('section',60,330,{title:'課題',sec:35,hint:'課題の深刻さを数字で。誰が・どれだけ困っているか',memo:'数字を強調'});
    const sol=N('section',60,490,{title:'ソリューション',sec:40,hint:'一文で言い切る → 仕組みを3点で',memo:'スライド送り x2'});
    const br=N('branch',60,650,{title:'デモ判断',question:'デモは動きそう？',waitSec:8,def:'right'});
    const demo=N('section',-90,810,{title:'ライブデモ',sec:45,hint:'操作はゆっくり。結果が出るまで黙らない',memo:'失敗したら笑顔で動画に切替'});
    const bak=N('section',210,810,{title:'デモ動画（バックアップ）',sec:30,hint:'録画を流しながら要点を口頭で補足'});
    const tr=N('section',60,970,{title:'トラクション・チーム',sec:25,hint:'導入実績 / 成長率 / チームの強み'});
    const cl=N('section',60,1130,{title:'クロージング',sec:20,hint:'「私たちは◯◯を変えます」＋お願い事項',memo:'最後は静止して一礼'});
    const e=N('end',60,1290);
    s.next=hook.id; hook.next=prob.id; prob.next=sol.id; sol.next=br.id;
    br.left={label:'ライブで行く',next:demo.id}; br.right={label:'動画に切替',next:bak.id};
    demo.next=tr.id; bak.next=tr.id; tr.next=cl.id; cl.next=e.id;
    T.push(t);
  }
  { // sales 5min with reaction branch
    const t=newTimer('営業ショート（反応分岐）'); t.nodes=[]; t.desc='相手の反応を見て深掘り/短縮を切り替える5分商談。'; t.targetSec=300;
    const N=(type,x,y,p)=>{const n=Object.assign(newNode(type,x,y),p); t.nodes.push(n); return n};
    const s=N('start',60,40);
    const ice=N('section',60,170,{title:'アイスブレイク',sec:30,hint:'相手の近況に一言触れる',memo:'売り込まない'});
    const pain=N('section',60,330,{title:'課題ヒアリング',sec:60,hint:'「今いちばん時間を取られているのは？」',memo:'話す3割・聞く7割'});
    const pitch=N('section',60,490,{title:'提案サマリー',sec:60,hint:'相手の言葉を使って提案を言い換える'});
    const br=N('branch',60,650,{title:'反応チェック',question:'反応は良い？',waitSec:10,def:'right'});
    const deep=N('section',-90,810,{title:'深掘り・事例紹介',sec:90,hint:'同業の導入事例 → 効果の数字',memo:'資料P.6'});
    const shortc=N('section',210,810,{title:'要点だけ短縮版',sec:45,hint:'価格と導入の手軽さだけ伝えて引く',memo:'押さない。次回に繋ぐ'});
    const next=N('section',60,970,{title:'ネクストアクション',sec:30,hint:'日程をその場で仮押さえ'});
    const e=N('end',60,1130);
    s.next=ice.id; ice.next=pain.id; pain.next=pitch.id; pitch.next=br.id;
    br.left={label:'良い→深掘り',next:deep.id}; br.right={label:'微妙→短縮',next:shortc.id};
    deep.next=next.id; shortc.next=next.id; next.next=e.id;
    T.push(t);
  }
  { // 10min demo
    const t=newTimer('プロダクトデモ 10分'); t.nodes=[]; t.desc='機能デモ中心の10分。質問が出たら対応ルートへ。'; t.targetSec=600;
    const N=(type,x,y,p)=>{const n=Object.assign(newNode(type,x,y),p); t.nodes.push(n); return n};
    const s=N('start',60,40);
    const intro=N('section',60,170,{title:'イントロ・アジェンダ',sec:60,hint:'今日のゴールを最初に宣言'});
    const d1=N('section',60,330,{title:'デモ① コア機能',sec:180,hint:'いちばん刺さる機能から。結果画面で3秒止める'});
    const br=N('branch',60,490,{title:'質問対応',question:'ここで質問が出ている？',waitSec:12,def:'right'});
    const qa=N('section',-90,650,{title:'質疑対応',sec:90,hint:'答えに迷ったら「持ち帰って正確に回答します」'});
    const d2=N('section',210,650,{title:'デモ② 連携・応用',sec:150,hint:'実データに近いシナリオで'});
    const wrap=N('section',60,810,{title:'まとめ・導入ステップ',sec:90,hint:'導入3ステップ → 今日決めてほしいこと'});
    const e=N('end',60,970);
    s.next=intro.id; intro.next=d1.id; d1.next=br.id;
    br.left={label:'質問あり',next:qa.id}; br.right={label:'続行',next:d2.id};
    qa.next=d2.id; d2.next=wrap.id; wrap.next=e.id;
    T.push(t);
  }
  return T;
}
const TEMPLATES=buildTemplates();

/* memo snippet templates */
const MEMO_TPLS=['ここで間を取る','スライド送り','視線を上げる','数字を強調','質問を投げかける','笑顔・ゆっくり','デモ画面に切替','時間が押したら飛ばす'];

/* ================================================================
   Router
================================================================ */
let EDIT_ID=null;
function go(view){
  $$('.view').forEach(v=>v.classList.toggle('active', v.id==='view-'+view));
  if(view==='home') renderHome();
}
function exportTimer(t){
  const data={format:'pitchwatch',version:1,exportedAt:new Date().toISOString(),timer:t};
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
  a.download=(t.name||'pitchwatch').replace(/[\\/:*?"<>|]/g,'_')+'.pitchwatch.json';
  a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),5000);
  toast('ファイルを書き出しました');
}
$('#file-input').addEventListener('change',e=>{
  [...e.target.files].forEach(f=>{
    const r=new FileReader();
    r.onload=()=>{
      try{
        const j=JSON.parse(r.result);
        const t=sanitizeTimer(j.format==='pitchwatch'?j.timer:j);
        DB.timers[t.id]=t; persistTimers(); renderHome();
        toast(`「${t.name}」を読み込みました`);
      }catch(err){
        modalMsg('読み込めませんでした', `このファイルはPitchWatch形式ではないか、内容が壊れています。<br><span style="color:var(--text3);font-size:12px">詳細: ${esc(err.message)}</span><br><br>PitchWatchの「書き出し」で作成した .json ファイルを選んでください。`);
      }
    };
    r.readAsText(f);
  });
  e.target.value='';
});
</script>
<script>
/* ================================================================
   Modal helpers
================================================================ */
function openModal(html){ $('#modal').innerHTML=html; $('#modal-veil').classList.add('open'); }
function closeModal(){ $('#modal-veil').classList.remove('open'); }
$('#modal-veil').addEventListener('click',e=>{ if(e.target.id==='modal-veil') closeModal(); });
function modalMsg(title,body,foot){
  openModal(`<h3>${esc(title)}</h3><p class="sub" style="font-size:13.5px;line-height:1.7">${body}</p>
  <div class="foot">${foot||'<button class="btn primary" onclick="closeModal()">OK</button>'}</div>`);
}
function modalConfirm(title,body,onok,okLabel='削除する'){
  window.__confirmOk=()=>{closeModal(); onok()};
  modalMsg(title,body,`<button class="btn" onclick="closeModal()">キャンセル</button><button class="btn danger" onclick="__confirmOk()">${esc(okLabel)}</button>`);
}

/* ================================================================
   HOME
================================================================ */
function renderHome(){
  const wrap=$('#home-content');
  const timers=Object.values(DB.timers).sort((a,b)=>b.updatedAt-a.updatedAt);
  const firstTime=!localStorage.getItem(LS.seen);
  let html='';

  if(SESSION && SESSION.status!=='finished' && DB.timers[SESSION.timerId]){
    const t=DB.timers[SESSION.timerId];
    const cur=nodeOf(t,SESSION.currentId);
    html+=`<div class="resume-banner">
      <div class="live"><i></i>${SESSION.status==='paused'?'PAUSED':'LIVE'}</div>
      <div class="info"><b>${esc(t.name)}</b><span>進行中 — ${esc(cur?.title||'')}</span></div>
      <button class="btn primary sm" onclick="resumeSession()">復帰</button>
      <button class="btn sm" onclick="discardSession()">破棄</button>
    </div>`;
  }

  html+=`<div class="hero">
    <div class="eyebrow">Live pitch flow timer</div>
    <h2>本番を、設計どおりに。</h2>
    <p>ピッチの進行をフローチャートで設計し、本番は自動で進行。判断が必要な瞬間だけ、あなたが選ぶ。</p>
  </div>`;
  if(firstTime){
    html+=`<div class="empty" style="text-align:left;margin-bottom:20px">
      <b>はじめての方へ</b>
      <p style="margin-bottom:10px">①テンプレートから作成 → ②編集画面でノードと時間を調整 → ③「本番」で開始。本番中は自動で次のセクションへ進みます。</p>
      <button class="btn sm primary" onclick="useTemplate(0)">テンプレートで試してみる</button>
      <button class="btn sm ghost" onclick="localStorage.setItem('${LS.seen}','1');renderHome()" style="margin-left:6px">閉じる</button>
    </div>`;
  }

  html+=`<div class="fab-row">
    <button class="btn primary" onclick="createTimer()"><svg class="ic" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>新規作成</button>
    <button class="btn" onclick="$('#file-input').click()"><svg class="ic" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>ファイル読み込み</button>
  </div>`;

  html+=`<div class="section-h"><h3>マイタイマー</h3><div class="line"></div><span style="font-family:var(--font-mono);font-size:11px;color:var(--text3)">${timers.length}</span></div>`;
  if(!timers.length){
    html+=`<div class="empty"><b>まだタイマーがありません</b><p>新規作成するか、下のテンプレートから始めましょう。</p>
    <button class="btn primary" onclick="createTimer()">最初のタイマーを作る</button></div>`;
  }else{
    html+=`<div class="card-grid">`+timers.map(t=>timerCard(t,false)).join('')+`</div>`;
  }

  html+=`<div class="section-h"><h3>テンプレート</h3><div class="line"></div></div><div class="card-grid">`+
    TEMPLATES.map((t,i)=>timerCard(t,true,i)).join('')+`</div>
    <p style="color:var(--text3);font-size:11.5px;margin-top:26px;line-height:1.8">
    データはこのブラウザに自動保存されます。別端末で使うには「書き出し」したファイルを相手端末で「ファイル読み込み」してください。<br>
    スマホはブラウザメニューの「ホーム画面に追加」でアプリのように起動できます。</p>`;
  wrap.innerHTML=html;
}
function timerCard(t,isTpl,tplIdx){
  const tot=totalSec(t), p=mainPath(t);
  const colors={section:'var(--accent)',branch:'var(--branch)',start:'var(--ok)',end:'var(--danger)'};
  const bar=p.filter(n=>n.sec>0||n.type==='branch').map(n=>{
    const w=Math.max(2,((n.type==='branch'?n.waitSec:n.sec)/Math.max(1,tot))*100);
    return `<i style="width:${w}%;background:${colors[n.type]};opacity:.85"></i>`;
  }).join('');
  const over=t.targetSec&&tot>t.targetSec;
  const main=isTpl
    ?`onclick="useTemplate(${tplIdx})"`
    :`onclick="openEditor('${t.id}')"`;
  return `<div class="tcard ${isTpl?'tpl':''}" ${main} role="button" tabindex="0">
    ${isTpl?'<span class="tplmark">TEMPLATE</span>':`<button class="kebab btn ghost icon sm" onclick="event.stopPropagation();timerMenu('${t.id}')" aria-label="メニュー"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="19" r="1.6" fill="currentColor"/></svg></button>`}
    <h4>${esc(t.name)}</h4>
    <div class="meta"><span class="tt" ${over?'style="color:var(--danger)"':''}>${fmtS(tot)}</span><span>${t.nodes.length} ノード</span>${!isTpl?`<span>${rel(t.updatedAt)}</span>`:''}</div>
    <p class="desc">${esc(t.desc||(isTpl?'':' '))}</p>
    <div class="bar">${bar}</div>
    <div class="actions" onclick="event.stopPropagation()">
      ${isTpl
        ?`<button class="btn sm primary" onclick="useTemplate(${tplIdx})">このテンプレで作成</button>`
        :`<button class="btn sm primary" onclick="startRun('${t.id}')"><svg class="ic" viewBox="0 0 24 24"><polygon points="6 3 20 12 6 21 6 3" fill="currentColor" stroke="none"/></svg>本番</button>
          <button class="btn sm" onclick="openEditor('${t.id}')">編集</button>`}
    </div>
  </div>`;
}
function rel(ts){
  const d=(now()-ts)/1000;
  if(d<60)return 'たった今'; if(d<3600)return Math.floor(d/60)+'分前';
  if(d<86400)return Math.floor(d/3600)+'時間前'; return Math.floor(d/86400)+'日前';
}
function timerMenu(id){
  const t=DB.timers[id]; if(!t)return;
  openModal(`<h3>${esc(t.name)}</h3><p class="sub">${fmtS(totalSec(t))} ・ ${t.nodes.length}ノード</p>
  <div style="display:grid;gap:8px">
    <button class="btn" onclick="closeModal();openEditor('${id}')">編集する</button>
    <button class="btn" onclick="closeModal();startRun('${id}')">本番を開始</button>
    <button class="btn" onclick="closeModal();duplicateTimer('${id}')">複製する</button>
    <button class="btn" onclick="closeModal();exportTimer(DB.timers['${id}'])">ファイルに書き出し</button>
    <button class="btn danger" onclick="closeModal();deleteTimer('${id}')">削除する</button>
  </div>
  <div class="foot"><button class="btn ghost" onclick="closeModal()">閉じる</button></div>`);
}
function createTimer(){
  const t=newTimer(); DB.timers[t.id]=t; persistTimers();
  localStorage.setItem(LS.seen,'1');
  openEditor(t.id);
}
function useTemplate(i){
  const t=sanitizeTimer(JSON.parse(JSON.stringify(TEMPLATES[i])));
  t.name=TEMPLATES[i].name; t.desc=TEMPLATES[i].desc; t.targetSec=TEMPLATES[i].targetSec;
  DB.timers[t.id]=t; persistTimers(); localStorage.setItem(LS.seen,'1');
  toast('テンプレートから作成しました'); openEditor(t.id);
}
function duplicateTimer(id){
  const src=DB.timers[id]; if(!src)return;
  const t=sanitizeTimer(JSON.parse(JSON.stringify(src)));
  t.name=src.name+' のコピー'; t.desc=src.desc; t.targetSec=src.targetSec;
  DB.timers[t.id]=t; persistTimers(); renderHome(); toast('複製しました');
}
function deleteTimer(id){
  const t=DB.timers[id];
  modalConfirm('タイマーを削除','「'+esc(t.name)+'」を削除します。この操作は取り消せません。書き出してバックアップすることもできます。',()=>{
    if(SESSION&&SESSION.timerId===id){SESSION=null; persistSession()}
    delete DB.timers[id]; persistTimers(); renderHome(); toast('削除しました');
  });
}
function discardSession(){
  modalConfirm('進行を破棄','進行中の本番セッションを破棄してよいですか？',()=>{SESSION=null;persistSession();renderHome();},'破棄する');
}
function resumeSession(){ if(SESSION) enterRun(SESSION.timerId,true); }

/* ================================================================
   Settings
================================================================ */
$('#btn-settings').onclick=()=>{
  openModal(`<h3>設定</h3><p class="sub">テーマと通知はすべての画面に適用されます。</p>
  <div class="field"><label>テーマ</label><div class="theme-grid">${Object.entries(THEMES).map(([k,v])=>`
    <button class="theme-card ${SET.theme===k?'on':''}" data-th="${k}">
      <span class="sw-row">${v.c.map(c=>`<i style="background:${c}"></i>`).join('')}</span><b>${v.name}</b>
    </button>`).join('')}</div></div>
  <div class="field"><label>アクセント色（上書き）</label>
    <div class="row"><input type="color" id="set-accent" value="${SET.accent||'#ffb02e'}">
    <button class="btn" id="set-accent-clear">テーマ標準に戻す</button></div></div>
  <div class="set-group">
    <div class="tglrow"><span>サウンド</span><button class="tgl ${SET.sound?'on':''}" data-tg="sound" role="switch" aria-checked="${SET.sound}"></button></div>
    <div class="tglrow"><span style="flex:1">音量</span><input type="range" min="0" max="1" step=".05" value="${SET.volume}" id="set-vol" style="width:140px"></div>
    <div class="tglrow"><span>バイブレーション ${navigator.vibrate?'':'<small style="color:var(--text3)">(この端末は非対応)</small>'}</span><button class="tgl ${SET.vibe?'on':''}" data-tg="vibe" role="switch"></button></div>
    <div class="tglrow"><span>視覚フラッシュ通知</span><button class="tgl ${SET.flash?'on':''}" data-tg="flash" role="switch"></button></div>
    <div class="tglrow"><span>本番画面に現在時刻を表示</span><button class="tgl ${SET.clock?'on':''}" data-tg="clock" role="switch"></button></div>
    <div class="tglrow"><span>カウントダウン精度</span>
      <div class="seg" style="width:170px"><button class="${SET.precision==='s'?'on':''}" data-pr="s">秒</button><button class="${SET.precision==='ds'?'on':''}" data-pr="ds">0.1秒</button></div></div>
  </div>
  <div class="row">
    <button class="btn" id="set-test">通知テスト</button>
  </div>
  <p class="sub" style="margin-top:14px">キーボード: <span class="kbd">Space</span> 一時停止 / <span class="kbd">→</span> 次へ / <span class="kbd">←</span> 戻る / 分岐は <span class="kbd">←</span><span class="kbd">→</span> で選択</p>
  <div class="foot"><button class="btn primary" onclick="closeModal()">完了</button></div>`);
  $$('.theme-card').forEach(b=>b.onclick=()=>{SET.theme=b.dataset.th; persistSettings(); applyTheme(); $$('.theme-card').forEach(x=>x.classList.toggle('on',x===b))});
  $('#set-accent').oninput=e=>{SET.accent=e.target.value; persistSettings(); applyTheme()};
  $('#set-accent-clear').onclick=()=>{SET.accent=''; persistSettings(); applyTheme(); toast('テーマ標準色に戻しました')};
  $$('[data-tg]').forEach(b=>b.onclick=()=>{SET[b.dataset.tg]=!SET[b.dataset.tg]; persistSettings(); b.classList.toggle('on'); b.setAttribute('aria-checked',SET[b.dataset.tg])});
  $('#set-vol').oninput=e=>{SET.volume=+e.target.value; persistSettings()};
  $$('[data-pr]').forEach(b=>b.onclick=()=>{SET.precision=b.dataset.pr; persistSettings(); $$('[data-pr]').forEach(x=>x.classList.toggle('on',x===b))});
  $('#set-test').onclick=()=>{ac(); beep('node'); vibe([90,60,140]); flash(); toast('通知テストを実行しました')};
};
</script>
<script>
/* ================================================================
   EDITOR
================================================================ */
const ED={pan:{x:40,y:30},scale:1,sel:null,pendingPort:null,undo:[],clockOn:false,tlOpen:window.innerWidth>1100};
const NODE_W=190;
function T(){return DB.timers[EDIT_ID]}
function pushUndo(){
  ED.undo.push(JSON.stringify(T().nodes));
  if(ED.undo.length>60)ED.undo.shift();
}
function commit(rerender=true){
  T().updatedAt=now(); persistTimers();
  if(rerender) renderCanvas();
  renderTimeline();
}
function openEditor(id){
  EDIT_ID=id; closeModal();
  const t=T(); if(!t){go('home');return}
  ED.sel=null; ED.pendingPort=null; ED.undo=[];
  $('#ed-title').textContent=t.name;
  $('#tl-drawer').classList.toggle('closed',!ED.tlOpen);
  go('editor');
  renderCanvas(); renderTimeline(); closeInspector();
  fitView();
}
$('#ed-back').onclick=()=>{closeInspector(); go('home')};
$('#ed-title').addEventListener('blur',()=>{
  const v=$('#ed-title').textContent.trim().slice(0,80)||'無題のピッチ';
  $('#ed-title').textContent=v; T().name=v; commit(false);
});
$('#ed-title').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();e.target.blur()}});
$('#ed-undo').onclick=()=>{
  if(!ED.undo.length){toast('これ以上戻せません');return}
  T().nodes=JSON.parse(ED.undo.pop()); ED.sel=null; closeInspector(); commit(); toast('1つ前に戻しました');
};
$('#ed-tl').onclick=()=>{ED.tlOpen=!ED.tlOpen; $('#tl-drawer').classList.toggle('closed',!ED.tlOpen)};
$('#ed-run').onclick=()=>startRun(EDIT_ID);
$$('.ed-toolbar [data-add]').forEach(b=>b.onclick=()=>addNode(b.dataset.add));
function addNode(type){
  pushUndo();
  const wrap=$('#canvas-wrap').getBoundingClientRect();
  const x=(wrap.width/2-ED.pan.x)/ED.scale-NODE_W/2+(Math.random()*40-20);
  const y=(wrap.height/2-ED.pan.y)/ED.scale-40+(Math.random()*40-20);
  const n=newNode(type,x,y);
  T().nodes.push(n); ED.sel=n.id; commit(); openInspector(n.id);
}

/* ----- clock chip ----- */
setInterval(()=>{
  const s=new Date().toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  if(ED.clockOn) $('#ed-clock').textContent=s;
  $('#run-clock').textContent=SET.clock?s:'';
},1000);

/* ----- canvas render ----- */
function portPos(n,which){ // world coords
  const h=nodeH(n);
  if(n.type==='branch'){
    if(which==='l')return {x:n.x+NODE_W*.26, y:n.y+h};
    if(which==='r')return {x:n.x+NODE_W*.74, y:n.y+h};
  }
  return {x:n.x+NODE_W/2, y:n.y+h};
}
function nodeH(n){ const el=$(`#nodes-layer [data-id="${n.id}"]`); return el?el.offsetHeight:84; }
function edgePath(a,b){
  const dy=Math.max(34,(b.y-a.y)/2);
  return `M ${a.x} ${a.y} C ${a.x} ${a.y+dy}, ${b.x} ${b.y-dy}, ${b.x} ${b.y}`;
}
function renderCanvas(){
  const t=T(); if(!t)return;
  const layer=$('#nodes-layer');
  layer.innerHTML=t.nodes.map(n=>{
    const tn={start:'START',section:'SECTION',branch:'BRANCH',end:'END'}[n.type];
    const time=n.type==='branch'
      ?`<div class="ntime">判断待ち <b>${n.waitSec}s</b> → 既定:${esc(n[n.def]?.label||'')}</div>`
      :(n.sec>0?`<div class="ntime"><svg class="ic" style="width:13px;height:13px"><use href="#i-clock"/></svg><b>${fmtS(n.sec)}</b></div>`:'');
    const tot=Math.max(1,totalSec(t));
    const bar=(n.type==='section')?`<div class="tbar"><i style="width:${clamp(n.sec/tot*100,2,100)}%"></i></div>`:'';
    const ports=n.type==='end'?'':(n.type==='branch'
      ?`<div class="port l" data-port="l" data-id="${n.id}"><span class="plabel">${esc(n.left.label)}</span></div><div class="port r" data-port="r" data-id="${n.id}"><span class="plabel">${esc(n.right.label)}</span></div>`
      :`<div class="port" data-port="next" data-id="${n.id}"></div>`);
    return `<div class="node ${ED.sel===n.id?'sel':''}" data-id="${n.id}" data-type="${n.type}" style="left:${n.x}px;top:${n.y}px">
      <div class="ntype">${tn}</div>
      <h5>${esc(n.type==='branch'?(n.question||n.title):n.title)||'無題'}</h5>
      ${time}${n.memo||n.hint?`<div class="nmemo">${esc(n.hint||n.memo)}</div>`:''}${bar}${ports}
    </div>`;
  }).join('');
  drawEdges();
  applyPan();
}
function drawEdges(){
  const t=T(); if(!t)return;
  const svg=$('#edges');
  // compute extents
  let maxX=600,maxY=600;
  t.nodes.forEach(n=>{maxX=Math.max(maxX,n.x+400);maxY=Math.max(maxY,n.y+400)});
  svg.setAttribute('width',maxX);svg.setAttribute('height',maxY);
  let html='';
  t.nodes.forEach(n=>{
    const links=n.type==='branch'
      ?[['l',n.left.next],['r',n.right.next]]
      :(n.type==='end'?[]:[['next',n.next]]);
    links.forEach(([which,nid])=>{
      const tgt=nid&&nodeOf(t,nid); if(!tgt)return;
      const a=portPos(n,which), b={x:tgt.x+NODE_W/2,y:tgt.y-2};
      html+=`<path d="${edgePath(a,b)}" class="${which==='l'?'br-l':which==='r'?'br-r':''}" data-from="${n.id}" data-which="${which}"></path>`;
    });
  });
  svg.innerHTML=html+'<path id="pending-edge" class="pending" style="display:none"></path>';
  $$('#edges path[data-from]').forEach(p=>p.addEventListener('click',e=>{
    e.stopPropagation();
    const n=nodeOf(T(),p.dataset.from);
    modalConfirm('接続を解除','この接続線を削除しますか？',()=>{
      pushUndo();
      if(p.dataset.which==='next')n.next=null; else n[p.dataset.which==='l'?'left':'right'].next=null;
      commit();
    },'解除する');
  }));
}
function applyPan(){ $('#canvas').style.transform=`translate(${ED.pan.x}px,${ED.pan.y}px) scale(${ED.scale})`; }
function fitView(){
  const t=T(); if(!t||!t.nodes.length)return;
  const wrap=$('#canvas-wrap').getBoundingClientRect();
  const xs=t.nodes.map(n=>n.x), ys=t.nodes.map(n=>n.y);
  const minX=Math.min(...xs)-40, minY=Math.min(...ys)-40;
  const maxX=Math.max(...xs)+NODE_W+40, maxY=Math.max(...ys)+140;
  const sc=clamp(Math.min(wrap.width/(maxX-minX), wrap.height/(maxY-minY)), .35, 1);
  ED.scale=sc;
  ED.pan={x:(wrap.width-(maxX-minX)*sc)/2-minX*sc, y:Math.max(14,(wrap.height-(maxY-minY)*sc)/2)-minY*sc};
  applyPan();
}
$('#zoom-in').onclick=()=>{ED.scale=clamp(ED.scale*1.2,.3,2);applyPan()};
$('#zoom-out').onclick=()=>{ED.scale=clamp(ED.scale/1.2,.3,2);applyPan()};
$('#zoom-fit').onclick=fitView;

/* ----- pointer interactions: pan / drag node / ports ----- */
(function(){
  const wrap=$('#canvas-wrap');
  let drag=null; // {mode:'pan'|'node', ...}
  let lastTapPort=0;
  wrap.addEventListener('pointerdown',e=>{
    const portEl=e.target.closest('.port');
    if(portEl){ e.stopPropagation(); startConnect(portEl.dataset.id, portEl.dataset.port); return; }
    const nodeEl=e.target.closest('.node');
    if(nodeEl){
      const n=nodeOf(T(),nodeEl.dataset.id);
      if(ED.pendingPort){ finishConnect(n.id); return; }
      drag={mode:'node',n,el:nodeEl,sx:e.clientX,sy:e.clientY,ox:n.x,oy:n.y,moved:false,undoPushed:false};
    }else{
      drag={mode:'pan',sx:e.clientX,sy:e.clientY,ox:ED.pan.x,oy:ED.pan.y,moved:false};
      if(ED.pendingPort){ cancelConnect(); }
    }
    wrap.setPointerCapture(e.pointerId);
  });
  wrap.addEventListener('pointermove',e=>{
    if(ED.pendingPort){ // live pending edge
      const t=T(); const n=nodeOf(t,ED.pendingPort.id);
      const a=portPos(n,ED.pendingPort.which);
      const r=wrap.getBoundingClientRect();
      const b={x:(e.clientX-r.left-ED.pan.x)/ED.scale,y:(e.clientY-r.top-ED.pan.y)/ED.scale};
      const pe=$('#pending-edge'); pe.style.display=''; pe.setAttribute('d',edgePath(a,b));
    }
    if(!drag)return;
    const dx=e.clientX-drag.sx, dy=e.clientY-drag.sy;
    if(Math.abs(dx)+Math.abs(dy)>4)drag.moved=true;
    if(drag.mode==='pan'){ ED.pan.x=drag.ox+dx; ED.pan.y=drag.oy+dy; applyPan(); }
    else{
      if(!drag.undoPushed&&drag.moved){pushUndo();drag.undoPushed=true}
      drag.n.x=Math.round(drag.ox+dx/ED.scale); drag.n.y=Math.round(drag.oy+dy/ED.scale);
      drag.el.style.left=drag.n.x+'px'; drag.el.style.top=drag.n.y+'px';
      drawEdges();
    }
  });
  wrap.addEventListener('pointerup',e=>{
    if(drag){
      if(drag.mode==='node'&&!drag.moved){ ED.sel=drag.n.id; renderCanvas(); openInspector(drag.n.id); }
      else if(drag.mode==='node'&&drag.moved){ commit(false); renderTimeline(); }
      else if(drag.mode==='pan'&&!drag.moved){ ED.sel=null; closeInspector(); renderCanvas(); }
    }
    drag=null;
  });
  wrap.addEventListener('pointercancel',()=>drag=null);
  // pinch zoom
  wrap.addEventListener('wheel',e=>{
    e.preventDefault();
    const r=wrap.getBoundingClientRect();
    const mx=e.clientX-r.left, my=e.clientY-r.top;
    const old=ED.scale;
    ED.scale=clamp(ED.scale*(e.deltaY<0?1.08:0.92),.3,2);
    ED.pan.x=mx-(mx-ED.pan.x)*ED.scale/old;
    ED.pan.y=my-(my-ED.pan.y)*ED.scale/old;
    applyPan();
  },{passive:false});
})();
function showHint(msg,withCancel){
  const h=$('#ed-hint');
  h.className='ed-hint'; h.style.display='flex';
  h.innerHTML=esc(msg)+(withCancel?'<button class="btn sm" onclick="cancelConnect()">キャンセル</button>':'');
  if(!withCancel)setTimeout(()=>h.style.display='none',2400);
}
function startConnect(id,which){
  ED.pendingPort={id,which};
  $$('.port').forEach(p=>p.classList.toggle('pending',p.dataset.id===id&&p.dataset.port===which));
  $$('.node').forEach(n=>{ if(n.dataset.id!==id&&n.dataset.type!=='start')n.classList.add('linkable') });
  showHint('接続先のノードをタップしてください',true);
}
function cancelConnect(){
  ED.pendingPort=null; $('#ed-hint').style.display='none';
  $('#pending-edge')?.style.setProperty('display','none');
  $$('.linkable').forEach(n=>n.classList.remove('linkable'));
  $$('.port.pending').forEach(p=>p.classList.remove('pending'));
}
function finishConnect(targetId){
  const p=ED.pendingPort; if(!p)return;
  const t=T(); const src=nodeOf(t,p.id); const tgt=nodeOf(t,targetId);
  if(!tgt||tgt.id===src.id||tgt.type==='start'){ toast('そのノードには接続できません','warn'); return; }
  pushUndo();
  if(p.which==='next')src.next=targetId;
  else src[p.which==='l'?'left':'right'].next=targetId;
  cancelConnect(); commit(); toast('接続しました');
}
</script>
<script>
/* ----- inspector ----- */
function closeInspector(){$('#inspector').classList.remove('open')}
$('#insp-close').onclick=()=>{ED.sel=null;closeInspector();renderCanvas()};
$('#insp-del').onclick=()=>{
  const n=nodeOf(T(),ED.sel); if(!n)return;
  if(n.type==='start'){toast('開始ノードは削除できません','warn');return}
  modalConfirm('ノードを削除','「'+esc(n.type==='branch'?n.question:n.title)+'」を削除します。接続も解除されます。',()=>{
    pushUndo();
    const t=T();
    t.nodes=t.nodes.filter(x=>x.id!==n.id);
    t.nodes.forEach(x=>{
      if(x.next===n.id)x.next=null;
      if(x.type==='branch'){ if(x.left.next===n.id)x.left.next=null; if(x.right.next===n.id)x.right.next=null; }
    });
    ED.sel=null; closeInspector(); commit(); toast('削除しました');
  });
};
$('#insp-dup').onclick=()=>{
  const n=nodeOf(T(),ED.sel); if(!n)return;
  if(n.type==='start'){toast('開始ノードは複製できません','warn');return}
  pushUndo();
  const c=JSON.parse(JSON.stringify(n)); c.id=uid(); c.x+=30; c.y+=30; c.next=null;
  if(c.type==='branch'){c.left.next=null;c.right.next=null}
  T().nodes.push(c); ED.sel=c.id; commit(); openInspector(c.id); toast('複製しました');
};
function openInspector(id){
  const n=nodeOf(T(),id); if(!n)return;
  ED.sel=id;
  const tn={start:'START — 開始ノード',section:'SECTION — 基本ノード',branch:'BRANCH — 分岐選択',end:'END — 終了ノード'}[n.type];
  $('#insp-type').textContent=tn;
  $('#insp-type').style.color={start:'var(--ok)',section:'var(--accent)',branch:'var(--branch)',end:'var(--danger)'}[n.type];
  const b=$('#insp-body');
  let html='';
  if(n.type!=='branch'){
    html+=`<div class="field"><label>セクションタイトル</label><input id="f-title" value="${esc(n.title)}" maxlength="120" ${n.type==='start'?'placeholder="開始"':''}></div>`;
  }
  if(n.type==='section'){
    html+=`<div class="field"><label>所要時間</label>
      <div class="timewheel">
        <input id="f-min" type="number" inputmode="numeric" min="0" max="599" value="${Math.floor(n.sec/60)}"><span class="colon">:</span>
        <input id="f-sec" type="number" inputmode="numeric" min="0" max="59" value="${n.sec%60}">
      </div>
      <div class="steppers">${[-30,-10,-5,5,10,30,60].map(d=>`<button class="chip" data-step="${d}">${d>0?'+':''}${d}s</button>`).join('')}</div>
    </div>
    <div class="field"><label>字幕ヒント（本番で大きく表示）</label><textarea id="f-hint" maxlength="600" placeholder="本番中に視線に入るカンニング字幕">${esc(n.hint)}</textarea></div>
    <div class="field"><label>メモ（補足・小さく表示）</label><textarea id="f-memo" maxlength="600" style="min-height:54px">${esc(n.memo)}</textarea>
      <div class="memo-tpls">${MEMO_TPLS.map(m=>`<button class="chip" data-mtpl="${esc(m)}">${esc(m)}</button>`).join('')}</div></div>`;
  }
  if(n.type==='branch'){
    html+=`<div class="field"><label>質問文（本番で表示）</label><input id="f-q" value="${esc(n.question)}" maxlength="200" placeholder="例: デモは成功した？"></div>
    <div class="row">
      <div class="field"><label style="color:var(--branch)">◀ 左の選択肢</label><input id="f-ll" value="${esc(n.left.label)}" maxlength="40"></div>
      <div class="field"><label style="color:var(--sub)">右の選択肢 ▶</label><input id="f-rl" value="${esc(n.right.label)}" maxlength="40"></div>
    </div>
    <div class="field"><label>無操作のとき（既定で進む側）</label>
      <div class="seg"><button id="f-defl" class="${n.def==='left'?'on':''}">◀ ${esc(n.left.label)}</button><button id="f-defr" class="${n.def==='right'?'on':''}">${esc(n.right.label)} ▶</button></div></div>
    <div class="field"><label>判断の待ち時間（秒）— 経過すると既定側へ自動進行</label>
      <input id="f-wait" type="number" inputmode="numeric" min="3" max="600" value="${n.waitSec}"></div>
    <p class="sub">接続はノード下の ◀/▶ ポートから行えます。</p>`;
  }
  if(n.type!=='end'&&n.type!=='branch'){
    const t=T();
    const opts=t.nodes.filter(x=>x.id!==n.id&&x.type!=='start').map(x=>`<option value="${x.id}" ${n.next===x.id?'selected':''}>${esc(x.type==='branch'?('分岐: '+x.question):x.title)||'無題'}</option>`).join('');
    html+=`<div class="field"><label>次のノード</label><select id="f-next"><option value="">— 未接続 —</option>${opts}</select></div>`;
  }
  if(n.type!=='start'){
    html+=`<div class="field"><label>このノードのアラーム</label><div class="set-group" style="margin:0">
      <div class="tglrow"><span>サウンド</span><button class="tgl ${n.alarm.sound!==false?'on':''}" data-al="sound"></button></div>
      <div class="tglrow"><span>バイブ</span><button class="tgl ${n.alarm.vibe!==false?'on':''}" data-al="vibe"></button></div>
      <div class="tglrow" style="border:none"><span>フラッシュ</span><button class="tgl ${n.alarm.flash!==false?'on':''}" data-al="flash"></button></div>
    </div></div>`;
  }
  if(n.type==='start'){
    const t=T();
    html+=`<div class="field"><label>目標合計時間（分・0で未設定）</label><input id="f-target" type="number" inputmode="numeric" min="0" max="600" value="${Math.round((t.targetSec||0)/60)}"></div>
    <div class="field"><label>説明（ホームに表示）</label><textarea id="f-desc" maxlength="200" style="min-height:54px">${esc(t.desc)}</textarea></div>
    <div class="tglrow" style="border:none"><span>編集画面に現在時刻を表示</span><button class="tgl ${ED.clockOn?'on':''}" id="f-clock"></button></div>`;
  }
  b.innerHTML=html;
  $('#inspector').classList.add('open');
  // bind
  const upd=(fn)=>{pushUndo(); fn(); commit();};
  const bind=(sel,fn,ev='input')=>{const el=$(sel,b); if(el)el.addEventListener(ev,()=>{fn(el); T().updatedAt=now(); persistTimers(); renderCanvas(); renderTimeline();})};
  bind('#f-title',el=>n.title=el.value.slice(0,120));
  bind('#f-min',el=>n.sec=clamp((+el.value||0),0,599)*60+(n.sec%60));
  bind('#f-sec',el=>n.sec=Math.floor(n.sec/60)*60+clamp((+el.value||0),0,59));
  bind('#f-hint',el=>n.hint=el.value.slice(0,600));
  bind('#f-memo',el=>n.memo=el.value.slice(0,600));
  bind('#f-q',el=>n.question=el.value.slice(0,200));
  bind('#f-ll',el=>n.left.label=el.value.slice(0,40));
  bind('#f-rl',el=>n.right.label=el.value.slice(0,40));
  bind('#f-wait',el=>n.waitSec=clamp(+el.value||10,3,600));
  bind('#f-next',el=>n.next=el.value||null,'change');
  bind('#f-target',el=>T().targetSec=clamp(+el.value||0,0,600)*60);
  bind('#f-desc',el=>T().desc=el.value.slice(0,200));
  const fc=$('#f-clock',b); if(fc)fc.onclick=()=>{ED.clockOn=!ED.clockOn; fc.classList.toggle('on'); $('#ed-clock').style.display=ED.clockOn?'':'none'};
  $$('#f-defl,#f-defr',b).forEach(x=>x.onclick=()=>{n.def=x.id==='f-defl'?'left':'right'; commit(false); openInspector(id)});
  $$('[data-step]',b).forEach(x=>x.onclick=()=>{
    n.sec=clamp(n.sec+(+x.dataset.step),5,36000);
    commit(false); renderCanvas(); renderTimeline();
    $('#f-min',b).value=Math.floor(n.sec/60); $('#f-sec',b).value=n.sec%60;
  });
  $$('[data-mtpl]',b).forEach(x=>x.onclick=()=>{
    n.memo=(n.memo?n.memo+' / ':'')+x.dataset.mtpl;
    $('#f-memo',b).value=n.memo; commit(false); renderCanvas();
  });
  $$('[data-al]',b).forEach(x=>x.onclick=()=>{
    const k=x.dataset.al; n.alarm[k]=n.alarm[k]===false?true:false; x.classList.toggle('on'); commit(false);
  });
}

/* ----- timeline drawer ----- */
function renderTimeline(){
  const t=T(); if(!t||!$('#view-editor').classList.contains('active'))return;
  const p=mainPath(t), tot=totalSec(t);
  const totEl=$('#tl-total');
  const over=t.targetSec&&tot>t.targetSec;
  totEl.className='tl-total'+(over?' over':'');
  totEl.innerHTML=fmtS(tot)+(t.targetSec?` <span class="lim">/ 目標 ${fmtS(t.targetSec)}${over?' 超過':''}</span>`:'');
  const colors={section:'var(--accent)',branch:'var(--branch)',start:'var(--ok)',end:'var(--danger)'};
  const maxSec=Math.max(...p.map(n=>n.type==='branch'?n.waitSec:n.sec),1);
  let acc=0;
  $('#tl-list').innerHTML=p.map(n=>{
    const sec=n.type==='branch'?n.waitSec:(n.sec||0);
    const h=14+Math.round(sec/maxSec*58);
    const longest=sec===maxSec&&sec>0;
    const row=`<div class="tl-row ${ED.sel===n.id?'cur':''}" onclick="focusNode('${n.id}')">
      <div class="tl-rail"><span class="tick">${fmtS(acc)}</span><span class="seg" style="background:${colors[n.type]};min-height:${h}px;opacity:${sec?1:.35}"></span></div>
      <div class="tl-info"><b>${esc(n.type==='branch'?('⑂ '+n.question):n.title)||'無題'}</b>
      <span>${sec?fmtS(sec):'—'}${longest?' ・最長':''}${n.type==='branch'?' 判断':''}</span></div>
    </div>`;
    acc+=sec; return row;
  }).join('')+`<div class="tl-row"><div class="tl-rail"><span class="tick">${fmtS(acc)}</span></div><div class="tl-info"><span>既定ルート合計</span></div></div>`
  +validateTimer(t).map(w=>`<div class="tl-warn">⚠ ${esc(w)}</div>`).join('');
}
function focusNode(id){
  const t=T(); const n=nodeOf(t,id); if(!n)return;
  ED.sel=id;
  const wrap=$('#canvas-wrap').getBoundingClientRect();
  ED.pan.x=wrap.width/2-(n.x+NODE_W/2)*ED.scale;
  ED.pan.y=wrap.height/2-(n.y+50)*ED.scale;
  renderCanvas(); openInspector(id);
}
</script>
<svg style="display:none"><symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol></svg>
<script>
/* ================================================================
   RUN ENGINE
================================================================ */
let tickIv=null, lastRenderedNode=null, lastPersist=0;
function runTimer(){return SESSION?DB.timers[SESSION.timerId]:null}
function curNode(){const t=runTimer(); return t?nodeOf(t,SESSION.currentId):null}
function nodeLimit(n){return n.type==='branch'?(n.waitSec||10):(n.sec||0)}
function elapsedInNode(){
  if(!SESSION)return 0;
  const ref=SESSION.status==='paused'?SESSION.pausedAt:now();
  return Math.max(0,(ref-SESSION.enteredAt)/1000);
}
function startRun(id){
  const t=DB.timers[id]; if(!t)return;
  if(SESSION && SESSION.status!=='finished' && SESSION.timerId!==id){
    modalConfirm('別の本番が進行中','進行中のセッションを破棄して新しく開始しますか？',()=>{SESSION=null;persistSession();startRun(id)},'破棄して開始');
    return;
  }
  const warns=validateTimer(t);
  if(warns.length){
    modalMsg('開始前チェック', warns.map(w=>'⚠ '+esc(w)).join('<br>')+'<br><br>このまま開始すると未接続地点で終了扱いになります。',
      `<button class="btn" onclick="closeModal()">編集に戻る</button><button class="btn primary" onclick="closeModal();enterRun('${id}',false)">このまま開始</button>`);
    return;
  }
  enterRun(id,false);
}
function enterRun(id,resume){
  closeModal(); closeInspector();
  if(!resume){
    SESSION={timerId:id,status:'ready',currentId:startNode(DB.timers[id]).id,enteredAt:now(),pausedAt:null,startedAt:null,log:[],note:''};
    persistSession();
  }
  go('run');
  keepAwake(true);
  lastRenderedNode=null;
  if(SESSION.status==='ready') renderReady();
  else { catchUp(); renderRunFrame(true); }
  clearInterval(tickIv); tickIv=setInterval(tick,SET.precision==='ds'?100:200);
  updateMuteBtn();
}
function beginCountdown(){
  ac(); // unlock audio within user gesture
  const t=runTimer(); const s=startNode(t);
  SESSION.status='running'; SESSION.startedAt=now();
  advanceTo(s.type==='start'?s.next:s.id,null,true);
  beep('node'); vibe(80);
}
function advanceTo(nextId,choiceLabel,silent){
  const t=runTimer();
  const prev=curNode();
  if(prev && SESSION.status!=='ready' && prev.type!=='start'){
    SESSION.log.push({nodeId:prev.id,title:prev.type==='branch'?prev.question:prev.title,type:prev.type,
      planned:nodeLimit(prev),actual:Math.round(elapsedInNode()*10)/10,choice:choiceLabel||null});
  }
  const nxt=nextId?nodeOf(t,nextId):null;
  if(!nxt){ finishRun(); return; }
  SESSION.currentId=nxt.id; SESSION.enteredAt=now();
  if(nxt.type==='end'){ finishRun(); return; }
  if(!silent) fireAlarm(nxt, nxt.type==='branch'?'branch':'node');
  persistSession();
  renderRunFrame(true);
}
function finishRun(){
  const t=runTimer();
  fireAlarm(curNode()||{}, 'end');
  SESSION.status='finished'; SESSION.endedAt=now(); persistSession();
  keepAwake(false);
  renderFinish();
}
function catchUp(){ // after reload: advance through nodes whose time already passed
  let guard=0;
  while(SESSION && SESSION.status==='running' && guard++<200){
    const n=curNode(); if(!n)break;
    const lim=nodeLimit(n);
    const el=elapsedInNode();
    if(el<lim || lim===0 && n.type!=='start') break;
    if(n.type==='start'){ SESSION.currentId=n.next; SESSION.enteredAt=now(); continue; }
    const nid=n.type==='branch'?n[n.def||'left']?.next:n.next;
    const spent=SESSION.enteredAt+lim*1000;
    SESSION.log.push({nodeId:n.id,title:n.type==='branch'?n.question:n.title,type:n.type,planned:lim,actual:lim,choice:n.type==='branch'?(n[n.def].label+'（自動）'):null});
    if(!nid||nodeOf(runTimer(),nid)?.type==='end'){ SESSION.currentId=nid||n.id; finishRun(); return; }
    SESSION.currentId=nid; SESSION.enteredAt=spent;
  }
  persistSession();
}
function tick(){
  if(!SESSION || !$('#view-run').classList.contains('active') && !$('#view-chart').classList.contains('active')){ return; }
  if(SESSION.status==='running'){
    const n=curNode();
    if(n){
      const lim=nodeLimit(n), el=elapsedInNode();
      if(lim>0 && el>=lim){
        if(n.type==='branch'){ chooseBranch(n.def||'left',true); }
        else advanceTo(n.next,null,false);
        return;
      }
    }
  }
  if(now()-lastPersist>1000 && SESSION.status==='running'){ lastPersist=now(); persistSession(); }
  if($('#view-run').classList.contains('active')) renderRunFrame(false);
  if($('#view-chart').classList.contains('active')) renderChartTick();
}

/* ---------- ready phase ---------- */
function renderReady(){
  const t=runTimer();
  $('#branch-veil').classList.remove('open');
  $('#run-bottom').style.visibility='hidden';
  $('#onair').style.visibility='hidden';
  $('#run-main').innerHTML=`<div class="ready-card">
    <div class="eyebrow">READY TO PITCH</div>
    <h2>${esc(t.name)}</h2>
    <div class="tot">既定ルート ${fmtS(totalSec(t))} ・ ${mainPath(t).length}ノード${t.targetSec?` ・ 目標 ${fmtS(t.targetSec)}`:''}</div>
    <div class="ready-checks">
      <button class="chip" onclick="ac();beep('node')">♪ 音テスト</button>
      <button class="chip" onclick="vibe([90,60,140])">📳 バイブ</button>
      <button class="chip" onclick="flash()">⚡ フラッシュ</button>
      <button class="chip" onclick="toggleFS()">⛶ 全画面</button>
    </div>
    <button class="go-btn" onclick="beginCountdown()">START</button>
    <p class="sub" style="margin-top:14px">開始後は自動で進行します。<br>分岐地点でのみ選択を求められます。</p>
  </div>`;
}

/* ---------- live frame ---------- */
function renderRunFrame(structural){
  const t=runTimer(); const n=curNode();
  if(!t||!n)return;
  if(SESSION.status==='finished'){ return; }
  if(SESSION.status==='ready'){ renderReady(); return; }
  $('#run-bottom').style.visibility=''; $('#onair').style.visibility='';
  const lim=nodeLimit(n), el=elapsedInNode(), remain=Math.max(0,lim-el);
  const prog=lim>0?clamp(el/lim,0,1):0;

  if(structural || lastRenderedNode!==n.id){
    lastRenderedNode=n.id;
    const nextN=n.type==='branch'?null:(n.next?nodeOf(t,n.next):null);
    const idx=SESSION.log.length+1;
    $('#run-main').innerHTML=`
      <div class="run-sec-label">SECTION ${String(idx).padStart(2,'0')}</div>
      <h2 class="run-title">${esc(n.type==='branch'?n.question:n.title)||'無題'}</h2>
      <div class="run-count" id="rc">--:--</div>
      ${nextN?`<div class="run-next"><span class="lbl">NEXT</span><b>${esc(nextN.type==='branch'?nextN.question:nextN.title)}</b><span style="font-family:var(--font-mono);font-size:11px;color:var(--text3)">${nextN.type==='branch'?'⑂':fmtS(nextN.sec)}</span></div>`:''}
      ${(n.hint||n.memo)?`<div class="run-hint">${esc(n.hint)}${n.memo?`<span class="memo">${esc(n.memo)}</span>`:''}</div>`:''}
    `;
    renderCtl(); renderMinimap();
    if(n.type==='branch') openBranch(n); else $('#branch-veil').classList.remove('open');
  }
  // countdown text
  const rc=$('#rc');
  if(rc){
    const f=fmt(remain,{ds:SET.precision==='ds'});
    rc.innerHTML=f.core+(f.ds!==null?`<span class="dsec">.${f.ds}</span>`:'');
    rc.classList.toggle('warn',remain<=10&&remain>5&&lim>15);
    rc.classList.toggle('crit',remain<=5&&lim>10);
  }
  // ring
  renderRing(prog,remain,lim);
  // branch timeout bar
  if(n.type==='branch'){
    const bar=$('#bto-bar'); if(bar)bar.style.width=(100-prog*100)+'%';
    const bs=$('#bto-s'); if(bs)bs.textContent=Math.ceil(remain)+'s';
  }
  // onair state
  const oa=$('#onair');
  oa.classList.toggle('paused',SESSION.status==='paused');
  oa.innerHTML=SESSION.status==='paused'?'<i></i><span>PAUSED</span>':'<i></i><span>ON AIR</span>';
}
function renderRing(prog,remain,lim){
  const R=46, C=2*Math.PI*R;
  const off=C*(1-prog);
  const crit=lim>0&&remain<=5;
  $('#subring').innerHTML=`
    <svg viewBox="0 0 108 108"><circle class="track" cx="54" cy="54" r="${R}"/>
    <circle class="prog ${crit?'crit':''}" cx="54" cy="54" r="${R}" stroke-dasharray="${C}" stroke-dashoffset="${off}"/></svg>
    <div class="inner"><span class="pct">${lim>0?Math.floor(prog*100)+'%':'—'}</span><span class="plbl">ELAPSED</span></div>`;
}
function renderCtl(){
  const paused=SESSION.status==='paused';
  $('#run-ctl').innerHTML=`
    <button class="rbtn" onclick="stepBack()" title="前へ戻る" aria-label="前へ戻る"><svg class="ic" viewBox="0 0 24 24"><polygon points="19 20 9 12 19 4 19 20" fill="currentColor" stroke="none"/><line x1="5" y1="19" x2="5" y2="5"/></svg></button>
    <button class="rbtn big" onclick="togglePause()" aria-label="${paused?'再開':'一時停止'}">${paused
      ?'<svg class="ic" viewBox="0 0 24 24"><polygon points="6 3 20 12 6 21 6 3" fill="currentColor" stroke="none"/></svg>'
      :'<svg class="ic" viewBox="0 0 24 24"><rect x="5" y="4" width="5" height="16" rx="1.5" fill="currentColor" stroke="none"/><rect x="14" y="4" width="5" height="16" rx="1.5" fill="currentColor" stroke="none"/></svg>'}</button>
    <button class="rbtn" onclick="skipNext()" title="次へスキップ" aria-label="次へスキップ"><svg class="ic" viewBox="0 0 24 24"><polygon points="5 4 15 12 5 20 5 4" fill="currentColor" stroke="none"/><line x1="19" y1="5" x2="19" y2="19"/></svg></button>`;
}
function togglePause(){
  if(!SESSION||SESSION.status==='ready'||SESSION.status==='finished')return;
  if(SESSION.status==='running'){ SESSION.status='paused'; SESSION.pausedAt=now(); beep('tick'); }
  else{ SESSION.enteredAt+=now()-SESSION.pausedAt; SESSION.status='running'; SESSION.pausedAt=null; beep('tick'); }
  persistSession(); renderCtl(); renderRunFrame(false);
}
function skipNext(){
  const n=curNode(); if(!n||SESSION.status==='finished')return;
  if(SESSION.status==='paused')togglePause();
  if(n.type==='branch') chooseBranch(n.def||'left',false,'スキップ');
  else advanceTo(n.next,null,false);
}
function stepBack(){
  if(!SESSION.log.length){toast('最初のセクションです');return}
  const last=SESSION.log.pop();
  SESSION.currentId=last.nodeId; SESSION.enteredAt=now();
  if(SESSION.status==='paused'){SESSION.status='running';SESSION.pausedAt=null}
  persistSession(); beep('tick'); renderRunFrame(true);
}
$('#run-exit').onclick=()=>{
  if(SESSION&&SESSION.status!=='finished'){
    modalMsg('本番を中断しますか？','セッションは保存され、ホームからいつでも復帰できます。',
    `<button class="btn" onclick="closeModal()">続ける</button>
     <button class="btn" onclick="closeModal();go('home')">中断して戻る</button>
     <button class="btn danger" onclick="closeModal();SESSION=null;persistSession();keepAwake(false);go('home')">破棄して終了</button>`);
  }else{ SESSION=null; persistSession(); go('home'); }
};
function updateMuteBtn(){
  $('#run-mute').innerHTML=SET.sound
    ?'<svg class="ic" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a9 9 0 0 1 0 14"/></svg>'
    :'<svg class="ic" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>';
}
$('#run-mute').onclick=()=>{SET.sound=!SET.sound; persistSettings(); updateMuteBtn(); toast(SET.sound?'サウンド オン':'サウンド オフ')};
function toggleFS(){
  if(document.fullscreenElement)document.exitFullscreen?.();
  else document.documentElement.requestFullscreen?.().catch(()=>toast('この環境では全画面にできません','warn'));
}
$('#run-fs').onclick=toggleFS;
</script>
<script>
/* ---------- branch overlay ---------- */
function openBranch(n){
  const t=runTimer();
  const lN=n.left.next?nodeOf(t,n.left.next):null, rN=n.right.next?nodeOf(t,n.right.next):null;
  const veil=$('#branch-veil');
  veil.innerHTML=`
    <div class="bq-label">DECISION POINT</div>
    <h3 class="bq">${esc(n.question||'どちらに進む？')}</h3>
    <div class="b-opts">
      <div class="b-card l" id="bc-l" role="button" tabindex="0">
        <span class="arr">◀</span><b>${esc(n.left.label)}</b>
        <span class="to">→ ${esc(lN?(lN.type==='branch'?lN.question:lN.title):'終了')}</span>
        ${n.def==='left'?'<span class="defmark">AUTO</span>':''}
      </div>
      <div class="b-card r" id="bc-r" role="button" tabindex="0">
        <span class="arr">▶</span><b>${esc(n.right.label)}</b>
        <span class="to">→ ${esc(rN?(rN.type==='branch'?rN.question:rN.title):'終了')}</span>
        ${n.def==='right'?'<span class="defmark">AUTO</span>':''}
      </div>
    </div>
    <div class="b-slider" id="b-slider"><span>◀ ${esc(n.left.label)}</span><div class="knob" id="b-knob"><svg class="ic" viewBox="0 0 24 24"><path d="M8 7l-4 5 4 5M16 7l4 5-4 5"/></svg></div><span>${esc(n.right.label)} ▶</span></div>
    <div class="b-timeout"><span>無操作で「${esc(n[n.def||'left'].label)}」へ</span><div class="bar"><i id="bto-bar" style="width:100%"></i></div><span id="bto-s"></span></div>`;
  veil.classList.add('open');
  $('#bc-l').onclick=()=>chooseBranch('left');
  $('#bc-r').onclick=()=>chooseBranch('right');
  // slide knob
  const knob=$('#b-knob'), slider=$('#b-slider');
  let kd=null;
  knob.addEventListener('pointerdown',e=>{kd={sx:e.clientX}; knob.setPointerCapture(e.pointerId)});
  knob.addEventListener('pointermove',e=>{
    if(!kd)return;
    const w=slider.offsetWidth/2-40;
    const dx=clamp(e.clientX-kd.sx,-w,w);
    knob.style.transform=`translate(calc(-50% + ${dx}px),-50%)`;
    $('#bc-l').classList.toggle('hot',dx<-w*.55);
    $('#bc-r').classList.toggle('hot',dx>w*.55);
    kd.dx=dx; kd.w=w;
  });
  knob.addEventListener('pointerup',()=>{
    if(!kd)return;
    if(kd.dx<-kd.w*.55)chooseBranch('left');
    else if(kd.dx>kd.w*.55)chooseBranch('right');
    else knob.style.transform='translate(-50%,-50%)';
    kd=null;
  });
}
function chooseBranch(side,auto,labelSuffix){
  const n=curNode(); if(!n||n.type!=='branch')return;
  const opt=n[side];
  $('#branch-veil').classList.remove('open');
  vibe(40);
  advanceTo(opt.next, opt.label+(auto?'（自動）':labelSuffix?`（${labelSuffix}）`:''), false);
}

/* ---------- minimap ---------- */
function miniSVG(t,curId,passedIds,w,h){
  const xs=t.nodes.map(n=>n.x),ys=t.nodes.map(n=>n.y);
  const minX=Math.min(...xs)-20,minY=Math.min(...ys)-20;
  const maxX=Math.max(...xs)+NODE_W+20,maxY=Math.max(...ys)+110;
  const sx=w/(maxX-minX), sy=h/(maxY-minY), s=Math.min(sx,sy);
  const ox=(w-(maxX-minX)*s)/2, oy=(h-(maxY-minY)*s)/2;
  const P=(x,y)=>[(x-minX)*s+ox,(y-minY)*s+oy];
  let svg='';
  t.nodes.forEach(n=>{
    const links=n.type==='branch'?[n.left.next,n.right.next]:(n.type==='end'?[]:[n.next]);
    links.forEach(nid=>{
      const tg=nid&&nodeOf(t,nid); if(!tg)return;
      const [x1,y1]=P(n.x+NODE_W/2,n.y+60),[x2,y2]=P(tg.x+NODE_W/2,tg.y);
      svg+=`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="var(--line2)" stroke-width="1"/>`;
    });
  });
  t.nodes.forEach(n=>{
    const [x,y]=P(n.x,n.y);
    const ww=NODE_W*s, hh=56*s;
    const cur=n.id===curId, passed=passedIds.has(n.id);
    const fill=cur?'var(--accent)':passed?'color-mix(in srgb,var(--ok) 60%,transparent)':'var(--surface2)';
    svg+=`<rect x="${x}" y="${y}" width="${ww}" height="${hh}" rx="${3*s+1.5}" fill="${fill}" stroke="${cur?'var(--accent)':'var(--line2)'}" stroke-width="${cur?1.5:0.7}"/>`;
  });
  return svg;
}
function renderMinimap(){
  const t=runTimer(); if(!t)return;
  const passed=new Set(SESSION.log.map(l=>l.nodeId));
  $('#minimap').innerHTML=`<svg viewBox="0 0 108 78">${miniSVG(t,SESSION.currentId,passed,108,66)}</svg><span class="mlbl">2タップで全体</span>`;
}
// double tap -> chart view
(function(){
  let lastTap=0;
  $('#minimap').addEventListener('pointerup',()=>{
    const tnow=now();
    if(tnow-lastTap<420){ openChartView(); lastTap=0; }
    else lastTap=tnow;
  });
  $('#minimap').addEventListener('dblclick',openChartView);
})();

/* ---------- run chart view (read-only) ---------- */
const CH={pan:{x:20,y:20},scale:.8};
function openChartView(){
  vibe(25);
  go('chart');
  renderChartStructure();
  centerChartOnCurrent();
}
$('#chart-back').onclick=()=>{go('run'); renderRunFrame(true)};
function renderChartStructure(){
  const t=runTimer(); if(!t)return;
  const passed=new Set(SESSION.log.map(l=>l.nodeId));
  const cur=curNode();
  const nextId=cur? (cur.type==='branch'?cur[cur.def||'left']?.next:cur.next):null;
  const cv=$('#chart-canvas');
  let maxX=600,maxY=600;
  t.nodes.forEach(n=>{maxX=Math.max(maxX,n.x+400);maxY=Math.max(maxY,n.y+300)});
  let edges=`<svg class="edges" width="${maxX}" height="${maxY}">`;
  t.nodes.forEach(n=>{
    const links=n.type==='branch'?[['l',n.left.next],['r',n.right.next]]:(n.type==='end'?[]:[['next',n.next]]);
    links.forEach(([which,nid])=>{
      const tg=nid&&nodeOf(t,nid); if(!tg)return;
      const a=portPosChart(n,which), b={x:tg.x+NODE_W/2,y:tg.y-2};
      const traveled=passed.has(n.id)&&(passed.has(tg.id)||tg.id===SESSION.currentId);
      edges+=`<path d="${edgePath(a,b)}" style="${traveled?'stroke:var(--ok);stroke-width:3':''}" class="${which==='l'?'br-l':which==='r'?'br-r':''}"></path>`;
    });
  });
  edges+='</svg>';
  cv.innerHTML=edges+t.nodes.map(n=>{
    const tn={start:'START',section:'SECTION',branch:'BRANCH',end:'END'}[n.type];
    const cls=n.id===SESSION.currentId?'cur':passed.has(n.id)?'passed':n.id===nextId?'nxt':'';
    const time=n.type==='branch'?`判断 ${n.waitSec}s`:(n.sec?fmtS(n.sec):'');
    return `<div class="cnode node ${cls}" data-cid="${n.id}" style="left:${n.x}px;top:${n.y}px;cursor:default">
      <div class="ntype" data-type="${n.type}">${tn}${n.id===nextId?' ・NEXT':''}</div>
      <h5>${esc(n.type==='branch'?n.question:n.title)||'無題'}</h5>
      <div class="ntime">${time}</div>
      ${n.id===SESSION.currentId?'<div class="cprog"><i id="ch-prog" style="width:0%"></i></div>':''}
    </div>`;
  }).join('');
  // colored type dots reuse .node[data-type] css via parent attr:
  $$('.cnode',cv).forEach(el=>{const ty=$('.ntype',el).dataset.type; el.dataset.type=ty});
  renderChartFoot();
  renderChartTick();
}
function portPosChart(n,which){
  const h=n.type==='branch'?92:84;
  if(n.type==='branch'){
    if(which==='l')return{x:n.x+NODE_W*.26,y:n.y+h};
    if(which==='r')return{x:n.x+NODE_W*.74,y:n.y+h};
  }
  return {x:n.x+NODE_W/2,y:n.y+h};
}
function renderChartFoot(){
  const t=runTimer(); const p=mainPath(t); const tot=Math.max(1,totalSec(t));
  const passed=new Set(SESSION.log.map(l=>l.nodeId));
  const colors={section:'var(--accent)',branch:'var(--branch)',start:'var(--ok)',end:'var(--danger)'};
  const bar=p.map(n=>{
    const sec=n.type==='branch'?n.waitSec:n.sec; if(!sec)return '';
    const op=passed.has(n.id)?'1':n.id===SESSION.currentId?'1':'0.3';
    return `<i style="width:${sec/tot*100}%;background:${colors[n.type]};opacity:${op}"></i>`;
  }).join('');
  const done=SESSION.log.reduce((a,l)=>a+l.actual,0);
  $('#chart-foot').innerHTML=`
    <span class="seg2"><span class="sw" style="background:var(--ok)"></span>通過</span>
    <span class="seg2"><span class="sw" style="background:var(--accent)"></span>現在</span>
    <div class="tlbar">${bar}</div>
    <span class="seg2">経過 ${fmtS(done+elapsedInNode())} / ${fmtS(tot)}</span>`;
}
function renderChartTick(){
  const n=curNode(); if(!n)return;
  const lim=nodeLimit(n), el=elapsedInNode();
  const pr=$('#ch-prog'); if(pr&&lim>0)pr.style.width=clamp(el/lim*100,0,100)+'%';
  $('#chart-remain').textContent='残り '+fmtS(Math.max(0,lim-el));
}
function centerChartOnCurrent(){
  const n=curNode(); const body=$('#chart-body').getBoundingClientRect();
  CH.scale=Math.min(1, body.width/700);
  if(n){ CH.pan.x=body.width/2-(n.x+NODE_W/2)*CH.scale; CH.pan.y=body.height/2.6-n.y*CH.scale; }
  $('#chart-canvas').style.transform=`translate(${CH.pan.x}px,${CH.pan.y}px) scale(${CH.scale})`;
}
(function(){ // chart pan (read-only)
  const body=$('#chart-body'); let d=null;
  body.addEventListener('pointerdown',e=>{d={sx:e.clientX,sy:e.clientY,ox:CH.pan.x,oy:CH.pan.y}; body.setPointerCapture(e.pointerId)});
  body.addEventListener('pointermove',e=>{ if(!d)return; CH.pan.x=d.ox+e.clientX-d.sx; CH.pan.y=d.oy+e.clientY-d.sy;
    $('#chart-canvas').style.transform=`translate(${CH.pan.x}px,${CH.pan.y}px) scale(${CH.scale})`});
  body.addEventListener('pointerup',()=>d=null);
  body.addEventListener('wheel',e=>{e.preventDefault();
    CH.scale=clamp(CH.scale*(e.deltaY<0?1.08:.92),.25,1.6);
    $('#chart-canvas').style.transform=`translate(${CH.pan.x}px,${CH.pan.y}px) scale(${CH.scale})`;
  },{passive:false});
})();

/* ---------- finish ---------- */
function renderFinish(){
  const t=runTimer();
  const planned=totalSec(t);
  const actual=(SESSION.endedAt-(SESSION.startedAt||SESSION.endedAt))/1000 - 0;
  $('#run-bottom').style.visibility='hidden';
  $('#branch-veil').classList.remove('open');
  $('#onair').style.visibility='hidden';
  const diff=actual-planned;
  const rows=SESSION.log.map(l=>{
    const d=l.actual-l.planned;
    return `<div class="sum-row">
      <span class="nm">${l.type==='branch'?'⑂ ':''}${esc(l.title)}</span>
      ${l.choice?`<span class="bch">${esc(l.choice)}</span>`:''}
      <span class="tm">${fmtS(l.actual)} / ${fmtS(l.planned)}</span>
      <span class="diff ${d>2?'over':d<-2?'under':''}">${d>0?'+':''}${Math.round(d)}s</span>
    </div>`;
  }).join('')||'<div class="sum-row"><span class="nm" style="color:var(--text3)">記録なし</span></div>';
  $('#run-main').innerHTML='';
  $('#run-main').insertAdjacentHTML('beforeend',`<div class="finish-wrap">
    <div class="finish-hero">
      <div class="ok-ring"><svg class="ic" style="width:40px;height:40px" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></div>
      <h2>ピッチ終了</h2>
      <div class="ft">実時間 ${fmtS(actual)} ・ 予定 ${fmtS(planned)} <span class="${diff>2?'diff over':diff<-2?'diff under':''}">(${diff>0?'+':''}${Math.round(diff)}s)</span></div>
    </div>
    <div class="sum-card"><h4>セクション別 — 実時間 / 予定</h4>${rows}</div>
    <div class="sum-card"><h4>振り返りメモ</h4>
      <textarea id="fin-note" placeholder="良かった点・次回への改善点を残しておく">${esc(SESSION.note||'')}</textarea></div>
    <div class="row" style="width:100%;max-width:560px">
      <button class="btn" onclick="restartSame()">もう一度</button>
      <button class="btn primary" onclick="saveAndHome()">保存してホームへ</button>
    </div>
  </div>`);
}
function saveAndHome(){
  const t=runTimer();
  if(t){
    t.lastRun={at:now(),actual:Math.round((SESSION.endedAt-SESSION.startedAt)/1000),log:SESSION.log,note:$('#fin-note')?.value.slice(0,1000)||''};
    persistTimers();
  }
  SESSION=null; persistSession(); keepAwake(false);
  document.exitFullscreen?.().catch(()=>{});
  go('home'); toast('実行ログを保存しました');
}
function restartSame(){
  const id=SESSION.timerId;
  SESSION=null; persistSession();
  startRun(id);
}

/* ---------- keyboard ---------- */
document.addEventListener('keydown',e=>{
  if(e.target.matches('input,textarea,[contenteditable]'))return;
  if($('#view-run').classList.contains('active') && SESSION && SESSION.status!=='ready' && SESSION.status!=='finished'){
    const n=curNode();
    if(e.code==='Space'){e.preventDefault();togglePause()}
    else if(n&&n.type==='branch'&&e.key==='ArrowLeft'){chooseBranch('left')}
    else if(n&&n.type==='branch'&&e.key==='ArrowRight'){chooseBranch('right')}
    else if(e.key==='ArrowRight'){skipNext()}
    else if(e.key==='ArrowLeft'){stepBack()}
  }
  if($('#view-chart').classList.contains('active')&&e.key==='Escape'){go('run');renderRunFrame(true)}
  if($('#view-editor').classList.contains('active')&&(e.metaKey||e.ctrlKey)&&e.key==='z'){e.preventDefault();$('#ed-undo').click()}
});

/* ---------- init ---------- */
applyTheme();
window.addEventListener('resize',debounce(()=>{ if($('#view-editor').classList.contains('active'))drawEdges(); },200));
window.addEventListener('beforeunload',()=>{ if(SESSION&&SESSION.status==='running')persistSession(); });
(function init(){
  // resume in-progress session straight into run view
  if(SESSION && SESSION.status && SESSION.status!=='finished' && DB.timers[SESSION.timerId]){
    go('home'); // home shows resume banner; do not yank user into run automatically
  }else{
    if(SESSION&&SESSION.status==='finished'){SESSION=null;persistSession()}
    go('home');
  }
})();
</script>
</body>
</html>
